<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimmerAndSear.Domain\SimmerAndSear.Domain.csproj" />
    <ProjectReference Include="..\SimmerAndSear.Application\SimmerAndSear.Application.csproj" />
    <ProjectReference Include="..\SimmerAndSear.Infrastructure\SimmerAndSear.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!-- The manifest and the photography travel with the binary so the seeder can
         be run from a published folder, not just from the source tree. -->
    <Content Include="SeedData\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
