@using SimmerAndSear.Web.ViewModels
@model ProfileVm
@{
    ViewData["Title"] = "My Profile";
}

<div class="animate-fade-in" style="background: #f3f4f6; min-height: 80vh; padding: 3rem 1.5rem;">
    <div class="container" style="max-width: 1100px;">

        <h1 style="display: flex; align-items: center; gap: 0.75rem; font-size: 2.25rem; margin: 0 0 2rem;">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="var(--ss-brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            My Profile
        </h1>

        @if (TempData["ProfileMessage"] is string ok)
        {
            <div role="status" style="background: #dcfce7; border: 1px solid #86efac; color: #166534; padding: 0.9rem 1.25rem; border-radius: 8px; margin-bottom: 1.5rem;">@ok</div>
        }
        @if (TempData["ProfileError"] is string problem)
        {
            <div role="alert" style="background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; padding: 0.9rem 1.25rem; border-radius: 8px; margin-bottom: 1.5rem;">@problem</div>
        }

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; align-items: start;">

            <!-- LEFT COLUMN -->
            <div style="display: flex; flex-direction: column; gap: 1.5rem;">

                <div class="card" style="background: white; padding: 1.75rem; border-top: 3px solid var(--ss-brand);">
                    <h2 style="font-size: 1.15rem; margin: 0 0 1.25rem;">Account Details</h2>
                    <p style="margin: 0 0 0.5rem; color: var(--ss-ink-muted); font-size: 0.95rem;">
                        <strong style="color: var(--ss-ink);">Name:</strong> @Model.Name
                    </p>
                    <p style="margin: 0; color: var(--ss-ink-muted); font-size: 0.95rem;">
                        <strong style="color: var(--ss-ink);">Email:</strong> @Model.Email
                    </p>
                </div>

                @if (Model.IsStaff)
                {
                    <div class="card" style="background: white; padding: 1.75rem;">
                        <h2 style="font-size: 1.15rem; margin: 0 0 1rem;">Administration</h2>
                        <a href="/Admin" class="btn btn-outline" style="color: var(--ss-brand); border-color: var(--ss-brand); text-decoration: none; display: inline-block;">Go to Admin Dashboard</a>
                    </div>
                }
                else
                {
                    <div class="card" style="background: white; padding: 1.75rem;">
                        <h2 style="display: flex; align-items: center; gap: 0.5rem; font-size: 1.15rem; margin: 0 0 1.25rem;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--ss-ink-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                            Update Email
                        </h2>
                        <form asp-controller="Auth" asp-action="UpdateEmail" method="post" style="display: flex; flex-direction: column; gap: 1rem; align-items: flex-start;">
                            <label for="new-email" class="visually-hidden">New email address</label>
                            <input id="new-email" type="email" name="email" value="@Model.Email" required maxlength="254"
                                   style="width: 100%; padding: 0.7rem 0.9rem; border: 1px solid var(--ss-border); border-radius: 6px; font-size: 0.95rem;" />
                            <button type="submit" style="background: var(--ss-ink); color: white; border: none; padding: 0.65rem 1.1rem; border-radius: 6px; font-weight: 600; font-size: 0.9rem; cursor: pointer;">Update Email</button>
                        </form>
                    </div>

                    <div class="card" style="background: white; padding: 1.75rem;">
                        <h2 style="display: flex; align-items: center; gap: 0.5rem; font-size: 1.15rem; margin: 0 0 1.25rem;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--ss-ink-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="16" r="1"/><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            Update Password
                        </h2>
                        <form asp-controller="Auth" asp-action="UpdatePassword" method="post" style="display: flex; flex-direction: column; gap: 1rem; align-items: flex-start;">
                            @* The current password is required. Without it, anyone who finds an
                               unlocked browser could lock the real owner out for good. *@
                            <label for="current-password" class="visually-hidden">Current password</label>
                            <input id="current-password" type="password" name="currentPassword" placeholder="Current Password" autocomplete="current-password" required maxlength="128"
                                   style="width: 100%; padding: 0.7rem 0.9rem; border: 1px solid var(--ss-border); border-radius: 6px; font-size: 0.95rem;" />

                            <label for="new-password" class="visually-hidden">New password, at least 12 characters</label>
                            <input id="new-password" type="password" name="newPassword" placeholder="New Password" autocomplete="new-password" required minlength="12" maxlength="128"
                                   style="width: 100%; padding: 0.7rem 0.9rem; border: 1px solid var(--ss-border); border-radius: 6px; font-size: 0.95rem;" />

                            <button type="submit" style="background: var(--ss-ink); color: white; border: none; padding: 0.65rem 1.1rem; border-radius: 6px; font-weight: 600; font-size: 0.9rem; cursor: pointer;">Update Password</button>
                        </form>
                    </div>

                    <div class="card" style="background: #fef2f2; border: 1px solid #fecaca; padding: 1.75rem;">
                        <h2 style="display: flex; align-items: center; gap: 0.5rem; font-size: 1.05rem; margin: 0 0 0.9rem; color: #b91c1c;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                            Danger Zone (Please Note*)
                        </h2>
                        <p style="margin: 0 0 1.25rem; color: #991b1b; font-size: 0.9rem; line-height: 1.6;">
                            As stated in our policy your data cannot be deleted straight away for record keeping purposes.
                            Instead you can choose to deactivate your account and log back in at anytime. If your account
                            remains inactive for the full period your data will then be permanently deleted.
                        </p>
                        <form asp-controller="Auth" asp-action="Deactivate" method="post" data-confirm-deactivate>
                            <button type="submit" style="background: #ef4444; color: white; border: none; padding: 0.65rem 1.1rem; border-radius: 6px; font-weight: 600; font-size: 0.9rem; cursor: pointer;">Deactivate Account</button>
                        </form>
                    </div>
                }
            </div>

            <!-- RIGHT COLUMN -->
            <div style="display: flex; flex-direction: column; gap: 1.5rem;">

                <div class="card" style="background: white; padding: 1.75rem;">
                    <h2 style="display: flex; align-items: center; gap: 0.5rem; font-size: 1.15rem; margin: 0 0 1.25rem;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--ss-brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
                        Order History
                    </h2>

                    @if (Model.Orders.Count == 0)
                    {
                        <p style="color: var(--ss-ink-muted); margin: 0; font-size: 0.95rem;">You have not placed any orders yet.</p>
                    }
                    else
                    {
                        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
                            @foreach (var order in Model.Orders)
                            {
                                <div style="background: #f8fafc; border-radius: 8px; overflow: hidden;">
                                    <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0.85rem 1.1rem; background: #e2e8f0;">
                                        <a href="/Cart/OrderConfirmation/@order.Id" style="font-weight: 700; color: var(--ss-ink); text-decoration: none; font-size: 0.95rem;">Order #@order.OrderReference</a>
                                        <span style="font-size: 0.8rem; font-weight: 600; color: var(--ss-ink-muted);">@order.Status</span>
                                    </div>
                                    <div style="padding: 1.1rem;">
                                        <div style="display: flex; justify-content: space-between; color: var(--ss-ink-muted); font-size: 0.82rem; margin-bottom: 0.9rem;">
                                            <span>Placed on @order.PlacedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                                            <span>@order.Items.Count item@(order.Items.Count == 1 ? "" : "s")</span>
                                        </div>
                                        @foreach (var line in order.Items)
                                        {
                                            <div style="display: flex; justify-content: space-between; gap: 1rem; font-size: 0.9rem; margin-bottom: 0.45rem;">
                                                <span style="color: var(--ss-ink);">@line.Quantity x @line.ProductName</span>
                                                <span style="color: var(--ss-ink-muted); white-space: nowrap;">@Money.Format(line.LineTotal, order.Currency)</span>
                                            </div>
                                        }
                                        <div style="display: flex; justify-content: space-between; border-top: 1px solid var(--ss-border); margin-top: 0.9rem; padding-top: 0.75rem; font-weight: 700;">
                                            <span>@(order.IsQuotation ? "Estimated Total" : "Total")</span>
                                            <span style="color: var(--ss-brand);">@Money.Format(order.Total, order.Currency)</span>
                                        </div>

                                        @* Only a quotation has a document behind it; a paid order has nothing to render. *@
                                        @if (order.IsQuotation)
                                        {
                                            <a href="/api/orders/@order.Id/quotation" target="_blank" rel="noopener" style="display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 0.85rem; color: var(--ss-brand); font-weight: 600; font-size: 0.85rem; text-decoration: none;">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                                                Download quotation (PDF)
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="card" style="background: white; padding: 1.75rem;">
                    <h2 style="display: flex; align-items: center; gap: 0.5rem; font-size: 1.15rem; margin: 0 0 1.25rem;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--ss-brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v5h5"/><path d="M9 13h6"/><path d="M9 17h3"/></svg>
                        My Reviews
                    </h2>

                    @if (Model.Reviews.Count == 0)
                    {
                        <p style="color: var(--ss-ink-muted); margin: 0; font-size: 0.95rem;">
                            You have not written any reviews yet. You can review a product once an order containing it has been delivered.
                        </p>
                    }
                    else
                    {
                        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
                            @foreach (var review in Model.Reviews)
                            {
                                <div style="background: #f8fafc; border-radius: 8px; overflow: hidden;">
                                    <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0.85rem 1.1rem; background: #e2e8f0;">
                                        <a href="/Catalogue/Detail/@review.ProductId" style="font-weight: 700; color: var(--ss-ink); text-decoration: none; font-size: 0.95rem;">@review.ProductName</a>
                                        @* A customer needs to know their review is queued, or they
                                           will wonder why it never appeared on the product page. *@
                                        <span style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; padding: 0.2rem 0.6rem; border-radius: 50px; @StatusBadge(review.Status)">@review.Status</span>
                                    </div>
                                    <div style="padding: 1.1rem;">
                                        <div style="display: flex; justify-content: space-between; margin-bottom: 0.6rem;">
                                            <span style="color: #f59e0b; font-weight: 700; font-size: 0.9rem;">@review.Rating Star@(review.Rating == 1 ? "" : "s")</span>
                                            <span style="color: var(--ss-ink-muted); font-size: 0.82rem;">@review.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(review.Title))
                                        {
                                            <div style="font-weight: 600; margin-bottom: 0.3rem;">@review.Title</div>
                                        }
                                        <p style="margin: 0; color: var(--ss-ink); font-size: 0.92rem; line-height: 1.6;">@review.Body</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <form asp-controller="Auth" asp-action="Logout" method="post" style="margin-top: 2rem;">
            <button class="btn btn-primary" type="submit">Sign out</button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/profile.js" asp-append-version="true"></script>
}

@functions {
    static string StatusBadge(string status) => status switch
    {
        "Approved" => "background: #dcfce7; color: #166534;",
        "Rejected" => "background: #fee2e2; color: #b91c1c;",
        _ => "background: #fef3c7; color: #92400e;"
    };
}
