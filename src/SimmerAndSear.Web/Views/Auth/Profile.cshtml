<div class="animate-fade-in section-light" style="min-height: 80vh; padding-bottom: 5rem;">
  <div class="container" style="max-width: 1200px;">
    <h1 style="margin-bottom: 3rem; display: flex; align-items: center; gap: 1rem; font-size: 2.5rem;">
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--ss-brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg> My Profile
    </h1>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 3rem;">
      
      <!-- LEFT COLUMN -->
      <div style="display: flex; flex-direction: column; gap: 2rem;">
        
        <div class="card" style="padding: 2.5rem; border-top: 4px solid var(--ss-brand);">
          <h2 style="font-size: 1.5rem; margin-bottom: 1.5rem; margin-top: 0; color: var(--ss-ink);">Account Details</h2>
          <div style="color: var(--ss-ink); font-size: 1.1rem;">
            <p style="margin: 0.5rem 0;"><strong style="color: var(--ss-ink-muted);">Name:</strong> [User Full Name]</p>
            <p style="margin: 0.5rem 0;"><strong style="color: var(--ss-ink-muted);">Email:</strong> [User Email Address]</p>
          </div>
        </div>

        <div class="card" style="padding: 2.5rem;">
          <h2 style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem; margin-top: 0; font-size: 1.25rem;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--ss-brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg> Update Email
          </h2>
          <form style="display: flex; flex-direction: column; gap: 1rem;">
            <input type="email" class="input-field" placeholder="[User Email Address]" required />
            <button type="submit" class="btn btn-secondary" style="width: fit-content;">Update Email</button>
          </form>
        </div>

        <div class="card" style="padding: 2.5rem;">
          <h2 style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem; margin-top: 0; font-size: 1.25rem;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--ss-brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg> Update Password
          </h2>
          <form style="display: flex; flex-direction: column; gap: 1rem;">
            <input type="password" class="input-field" placeholder="New Password" required />
            <button type="submit" class="btn btn-secondary" style="width: fit-content;">Update Password</button>
          </form>
        </div>

        <div class="card" style="padding: 2.5rem; border: 1px solid #ef4444; background: rgba(239, 68, 68, 0.05);">
          <h2 style="color: #ef4444; display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; margin-top: 0; font-size: 1.25rem;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg> Danger Zone (Please Note*)
          </h2>
          <p style="color: var(--ss-ink-muted); margin-bottom: 1.5rem; line-height: 1.6;">
            As stated in our policy your data cannot be deleted straight away for record keeping purposes. Instead you can choose to deactivate your account and log back in at anytime. If your account remains inactive for the full period your data will then be permanently deleted.
          </p>
          <button class="btn btn-primary" style="background: #ef4444;">
            Deactivate Account
          </button>
        </div>

      </div>

      <!-- RIGHT COLUMN -->
      <div style="display: flex; flex-direction: column; gap: 3rem;">
        
        <div class="card" style="padding: 2.5rem; flex: 1;">
          <h2 style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 2rem; margin-top: 0; font-size: 1.5rem;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--ss-brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg> Order History
          </h2>
          
          <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            <div style="border: 1px solid var(--ss-border); border-radius: var(--ss-radius); overflow: hidden;">
              <div style="display: flex; justify-content: space-between; align-items: center; background: var(--ss-surface-solid); padding: 1rem 1.5rem; border-bottom: 1px solid var(--ss-border);">
                <span style="font-weight: 600; font-size: 1.1rem;">Order #[Order ID]</span>
                <span style="font-weight: 600; padding: 0.25rem 0.75rem; border-radius: 50px; font-size: 0.85rem; background: rgba(16, 185, 129, 0.2); color: #10b981;">
                  [Status]
                </span>
              </div>
              
              <div style="padding: 1.5rem;">
                <div style="color: var(--ss-ink-muted); font-size: 0.9rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between;">
                  <span>Placed on [Order Date]</span>
                  <span>[Item Count] items</span>
                </div>
                
                <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.5rem;">
                  <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.95rem;">
                    <span>[Qty]x [Product Name]</span>
                    <span style="font-weight: 500;">[Price]</span>
                  </div>
                </div>
                
                <div style="border-top: 1px solid var(--ss-border); padding-top: 1rem; display: flex; justify-content: space-between; align-items: center;">
                  <span style="font-weight: 600; color: var(--ss-ink-muted);">Total</span>
                  <span style="font-weight: 700; font-size: 1.25rem; color: var(--ss-ink);">[Total Price]</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="card" style="padding: 2.5rem; flex: 1;">
          <h2 style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 2rem; margin-top: 0; font-size: 1.5rem;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--ss-brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg> My Reviews
          </h2>
          
          <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            <div style="border: 1px solid var(--ss-border); border-radius: var(--ss-radius); overflow: hidden;">
              <div style="background: var(--ss-surface-solid); padding: 1rem 1.5rem; border-bottom: 1px solid var(--ss-border);">
                <span style="font-weight: 600; font-size: 1.1rem;">[Product Name]</span>
              </div>
              
              <div style="padding: 1.5rem;">
                <div style="color: var(--ss-ink-muted); font-size: 0.9rem; margin-bottom: 1rem; display: flex; justify-content: space-between;">
                  <span style="color: #f59e0b; font-weight: bold;">[Rating] Stars</span>
                  <span>[Review Date]</span>
                </div>
                <p style="margin-bottom: 0; color: var(--ss-ink); line-height: 1.6;">[Review Text Goes Here...]</p>
              </div>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</div>
