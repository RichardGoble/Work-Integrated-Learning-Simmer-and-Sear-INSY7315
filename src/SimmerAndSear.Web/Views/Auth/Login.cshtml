@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Simmer & Sear</title>
    
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    
    <script>
        function toggleAuthMode() {
            var isLogin = document.getElementById('mode').value === 'login';
            if (isLogin) {
                document.getElementById('mode').value = 'register';
                document.getElementById('name-field').style.display = 'block';
                document.getElementById('submit-btn').innerText = 'Sign Up';
                document.getElementById('toggle-btn').innerText = 'Already have an account? Login';
                document.getElementById('google-btn-text').innerText = 'Sign up with Google';
            } else {
                document.getElementById('mode').value = 'login';
                document.getElementById('name-field').style.display = 'none';
                document.getElementById('submit-btn').innerText = 'Login';
                document.getElementById('toggle-btn').innerText = 'Need an account? Sign up';
                document.getElementById('google-btn-text').innerText = 'Sign in with Google';
            }
        }
    </script>
</head>
<body>
    <div style="display: flex; flex-direction: column; min-height: 100vh; justify-content: center; align-items: center; background-color: var(--ss-surface); padding: 2rem; position: relative;">
      
      <a href="/" style="position: absolute; top: 2rem; left: 2rem; display: flex; align-items: center; gap: 0.5rem; background: none; border: none; color: var(--ss-ink); cursor: pointer; font-size: 1rem; font-weight: 500; text-decoration: none;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg> 
        Back to Home
      </a>

      <div class="card animate-fade-in" style="width: 100%; max-width: 400px; padding: 3rem 2rem; text-align: center;">
        <div style="margin-bottom: 1.5rem; display: flex; justify-content: center;">
          <img src="/logo.png" alt="Simmer & Sear Logo" style="max-width: 200px; height: auto; object-fit: contain;" />
        </div>
        <p style="color: var(--ss-ink-muted); margin-bottom: 2rem;">Quality cookware for every home</p>

        @if (ViewData["Error"] as bool? == true)
        {
            <div style="color: red; margin-bottom: 1rem; padding: 0.5rem; background-color: #fee2e2; border-radius: 4px; font-size: 0.9rem;">Authentication failed.</div>
        }

        <form method="post" action="/api/accounts/login" style="display: flex; flex-direction: column; gap: 1rem;">
          <input type="hidden" id="mode" name="mode" value="login" />
          
          <input 
            type="text" 
            id="name-field"
            name="name"
            placeholder="Full Name" 
            class="input-field" 
            style="display: none;"
          />
          <input 
            type="email" 
            name="email"
            placeholder="Email Address" 
            class="input-field" 
            required
          />
          <input 
            type="password" 
            name="password"
            placeholder="Password" 
            class="input-field" 
            required
          />
          <button type="submit" id="submit-btn" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem;">
            Login
          </button>
        </form>

        <div style="margin: 1.5rem 0; display: flex; align-items: center; color: var(--ss-ink-muted);">
            <div style="flex: 1; height: 1px; background-color: var(--ss-border);"></div>
            <span style="padding: 0 1rem; font-size: 0.9rem;">or</span>
            <div style="flex: 1; height: 1px; background-color: var(--ss-border);"></div>
        </div>

        <button type="button" class="btn btn-outline" style="width: 100%; display: flex; justify-content: center; align-items: center; gap: 0.5rem; background-color: white;">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="20px" height="20px"><path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/><path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/><path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/><path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/></svg>
            <span id="google-btn-text">Sign in with Google</span>
        </button>

        <div style="margin-top: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
          <button type="button" id="toggle-btn" class="btn btn-outline" onclick="toggleAuthMode()" style="width: 100%;">
            Need an account? Sign up
          </button>
        </div>
      </div>
    </div>
</body>
</html>
