@using SimmerAndSear.Web.ViewModels.Components
@model List<CardVm>

<div class="animate-fade-in">
    <!-- Hero Section -->
    <section style="position: relative; width: 100%; display: flex; align-items: flex-end; justify-content: center; background-color: var(--ss-ink);">
        <img src="/images/home_banner.jpg" alt="Premium Cookware" style="width: 100%; height: auto; display: block;" />
        
        <div style="position: absolute; bottom: 0; left: 0; width: 100%; height: 30%; background: linear-gradient(0deg, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0) 100%); pointer-events: none;"></div>

        <div class="container" style="position: absolute; z-index: 10; display: flex; justify-content: center; bottom: 15%;">
            <div style="display: flex; gap: 1rem;">
                <a href="/Catalogue" class="btn btn-primary" style="padding: 1rem 3rem; font-size: 1.1rem; font-weight: bold; box-shadow: 0 4px 15px rgba(0,0,0,0.5);">
                    Shop Collection
                </a>
            </div>
        </div>
    </section>

    <!-- Featured Products -->
    <section class="section-light">
        <div class="container">
            <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 4rem;">
                <div>
                    <h2 style="font-size: 2.5rem; margin: 0;">Featured Collection</h2>
                </div>
                <a href="/Catalogue" class="btn btn-outline" style="display: flex; align-items: center; gap: 0.5rem;">
                    View All 
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
            </div>
            
            <div class="mobile-scroll-row" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 3rem;">
                @foreach (var product in Model)
                {
                    <partial name="_Card" model="product" />
                }
            </div>
        </div>
    </section>

    <!-- About Us Section -->
    <section class="section-light">
        <div class="container">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 6rem; align-items: center;">
                <div style="position: relative;">
                    <div style="width: 100%; height: 550px; position: relative; border-radius: var(--ss-radius-lg); overflow: hidden; box-shadow: var(--ss-shadow-2);">
                        <img src="/images/about_home.jpg" alt="Premium Cookware Selection" style="width: 100%; height: 100%; object-fit: cover;" />
                        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: rgba(255,255,255,0.95); padding: 1.5rem; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: var(--ss-shadow-3); cursor: pointer;">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="var(--ss-brand)" stroke="var(--ss-brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 8-6 4 6 4V8Z"/><rect width="14" height="12" x="2" y="6" rx="2" ry="2"/></svg>
                        </div>
                    </div>
                    
                    <div class="card" style="position: absolute; bottom: -2rem; right: -2rem; padding: 2rem; width: 280px; border-radius: var(--ss-radius-sm);">
                        <div style="display: flex; align-items: center; gap: 1.25rem; margin-bottom: 1.5rem;">
                            <div style="padding: 0.75rem; background: var(--ss-surface-solid); border-radius: 50%;">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--ss-brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
                            </div>
                            <h4 style="margin: 0; font-size: 1rem; color: var(--ss-ink);">Built to Last</h4>
                        </div>
                        <div style="display: flex; align-items: center; gap: 1.25rem;">
                            <div style="padding: 0.75rem; background: var(--ss-surface-solid); border-radius: 50%;">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--ss-brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
                            </div>
                            <h4 style="margin: 0; font-size: 1rem; color: var(--ss-ink);">Even Heat Distribution</h4>
                        </div>
                    </div>
                </div>
                
                <div style="padding-right: 2rem;">
                    <h2 style="margin-bottom: 2rem; font-size: 3rem;">Our Heritage.</h2>
                    <p style="color: var(--ss-ink); margin-bottom: 1.5rem; font-size: 1.25rem; line-height: 1.8;">
                        At Simmer & Sear, we believe that every great meal starts with the right tools. Our passion is providing durable, beautiful, and highly functional cookware that inspires chefs and home cooks alike.
                    </p>
                    <p style="color: var(--ss-ink-muted); margin-bottom: 3rem; font-size: 1.125rem; line-height: 1.8;">
                        Providing the highest quality materials straight to your kitchen.
                    </p>
                    <a href="/About" class="btn btn-secondary">Read Our Story</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Gallery Section -->
    <section class="section-accent">
        <div class="container">
            <div style="text-align: center; margin-bottom: 4rem;">
                <h2 style="font-size: 2.5rem; margin: 0;">In The Kitchen</h2>
                <p style="color: var(--ss-ink-muted); font-size: 1.25rem; margin-top: 0.5rem;">See our cookware in action</p>
            </div>
            <div class="mobile-scroll-row gallery-scroll" style="display: grid; grid-template-columns: repeat(4, 1fr); grid-template-rows: repeat(2, 300px); gap: 1.5rem;">
                <div style="width: 100%; height: 100%; border-radius: var(--ss-radius-sm); grid-column: 1 / 3; grid-row: 1 / 3; box-shadow: var(--ss-shadow-1); background: #e5e9f0; border: 2px dashed #c2c9d6; display: flex; align-items: center; justify-content: center; color: #4c566a; font-weight: 500; font-size: 1.25rem;">
                    [Gallery Image 1]
                </div>
                <div style="width: 100%; height: 100%; border-radius: var(--ss-radius-sm); box-shadow: var(--ss-shadow-1); background: #e5e9f0; border: 2px dashed #c2c9d6; display: flex; align-items: center; justify-content: center; color: #4c566a; font-weight: 500;">
                    [Gallery Image 2]
                </div>
                <div style="width: 100%; height: 100%; border-radius: var(--ss-radius-sm); box-shadow: var(--ss-shadow-1); background: #e5e9f0; border: 2px dashed #c2c9d6; display: flex; align-items: center; justify-content: center; color: #4c566a; font-weight: 500;">
                    [Gallery Image 3]
                </div>
                <div style="width: 100%; height: 100%; border-radius: var(--ss-radius-sm); grid-column: 3 / 5; box-shadow: var(--ss-shadow-1); background: #e5e9f0; border: 2px dashed #c2c9d6; display: flex; align-items: center; justify-content: center; color: #4c566a; font-weight: 500; font-size: 1.25rem;">
                    [Gallery Image 4]
                </div>
            </div>
        </div>
    </section>

    <!-- Quick Links Nav Section -->
    <section class="section-light">
        <div class="container">
            <div style="text-align: center; margin-bottom: 5rem;">
                <h2 style="font-size: 2.5rem;">Explore Simmer & Sear</h2>
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem;">
                
                <a href="/Catalogue" class="card" style="padding: 4rem 2rem; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.5rem; text-decoration: none;">
                    <div style="padding: 1.5rem; background: var(--ss-surface-solid); border-radius: 50%;">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--ss-brand)" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    </div>
                    <h3 style="font-size: 1.25rem; margin: 0;">Catalogue</h3>
                    <p style="color: var(--ss-ink-muted); margin: 0;">Browse all collections</p>
                </a>

                <a href="/News" class="card" style="padding: 4rem 2rem; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.5rem; text-decoration: none;">
                    <div style="padding: 1.5rem; background: var(--ss-surface-solid); border-radius: 50%;">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--ss-brand)" stroke-width="1.5"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6Z"/></svg>
                    </div>
                    <h3 style="font-size: 1.25rem; margin: 0;">Journal</h3>
                    <p style="color: var(--ss-ink-muted); margin: 0;">Read our latest stories</p>
                </a>

                <a href="/Contact" class="card" style="padding: 4rem 2rem; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.5rem; text-decoration: none;">
                    <div style="padding: 1.5rem; background: var(--ss-surface-solid); border-radius: 50%;">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--ss-brand)" stroke-width="1.5"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                    </div>
                    <h3 style="font-size: 1.25rem; margin: 0;">Support</h3>
                    <p style="color: var(--ss-ink-muted); margin: 0;">Reach out to place an order</p>
                </a>

                <a href="/Privacy" class="card" style="padding: 4rem 2rem; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.5rem; text-decoration: none;">
                    <div style="padding: 1.5rem; background: var(--ss-surface-solid); border-radius: 50%;">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--ss-brand)" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                    </div>
                    <h3 style="font-size: 1.25rem; margin: 0;">Privacy</h3>
                    <p style="color: var(--ss-ink-muted); margin: 0;">Read our policies</p>
                </a>

            </div>
        </div>
    </section>

    <!-- Elegant CONTACT CTA -->
    <section class="section-accent" style="padding-bottom: 10rem;">
        <div class="container">
            <div class="card" style="padding: 6rem 3rem; text-align: center; border-radius: var(--ss-radius-lg); background: var(--ss-surface); border: none;">
                <h2 style="font-size: 3rem; color: var(--ss-ink); margin-bottom: 1.5rem;">Ready to Upgrade Your Kitchen?</h2>
                <p style="font-size: 1.25rem; color: var(--ss-ink-muted); margin-bottom: 3rem; max-width: 600px; margin-left: auto; margin-right: auto;">
                    Our team of culinary experts is ready to help you select the perfect pots and pans for your specific needs.
                </p>
                <a href="/Contact" class="btn btn-primary" style="font-size: 1.125rem; padding: 1.25rem 3.5rem;">
                    Contact Us Today
                </a>
            </div>
        </div>
    </section>
</div>
