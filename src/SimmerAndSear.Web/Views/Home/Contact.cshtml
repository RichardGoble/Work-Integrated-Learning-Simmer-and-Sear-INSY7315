<div class="animate-fade-in">
  <div class="page-header">
    <div class="container">
      <h1>Contact Us</h1>
      <p>Have a question or want to place an order? Reach out to our team.</p>
    </div>
  </div>
  
  <section class="section-light">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 5rem;">
        
        <!-- Contact Info -->
        <div>
          <h2 style="margin-bottom: 1.5rem; font-size: 2.5rem;">Get In Touch</h2>
          <p style="color: var(--ss-ink-muted); margin-bottom: 3rem; font-size: 1.125rem;">
            We'd love to hear from you. Whether you're interested in our products, need help with an order, or just want to say hello.
          </p>
          
          <div style="display: flex; flex-direction: column; gap: 2rem;">
            <div style="display: flex; align-items: center; gap: 1.5rem;">
              <div style="background-color: rgba(242, 93, 7, 0.1); padding: 1.25rem; border-radius: 50%; color: var(--ss-brand);">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <h4 style="margin-bottom: 0.25rem; font-size: 1.1rem; margin-top: 0;">Our Office</h4>
                <p style="color: var(--ss-ink-muted); margin: 0;">123 Culinary Ave, Johannesburg, SA</p>
              </div>
            </div>
            
            <div style="display: flex; align-items: center; gap: 1.5rem;">
              <div style="background-color: rgba(242, 93, 7, 0.1); padding: 1.25rem; border-radius: 50%; color: var(--ss-brand);">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <div>
                <h4 style="margin-bottom: 0.25rem; font-size: 1.1rem; margin-top: 0;">Call Us</h4>
                <p style="color: var(--ss-ink-muted); margin: 0;">+27 11 123 4567</p>
              </div>
            </div>
            
            <div style="display: flex; align-items: center; gap: 1.5rem;">
              <div style="background-color: rgba(242, 93, 7, 0.1); padding: 1.25rem; border-radius: 50%; color: var(--ss-brand);">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </div>
              <div>
                <h4 style="margin-bottom: 0.25rem; font-size: 1.1rem; margin-top: 0;">Email Us</h4>
                <p style="color: var(--ss-ink-muted); margin: 0;">info@simmerandsear.co.za</p>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Contact Form -->
        <div class="card" style="padding: 3rem;">
          <h3 style="margin-bottom: 2rem; font-size: 1.5rem; margin-top: 0;">Send a Message</h3>
          @if (ViewData["SuccessMessage"] is string msg)
          {
              <div style="background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem; font-size: 0.95rem;">
                  @msg
              </div>
          }
          <form method="post" action="/Contact" style="display: flex; flex-direction: column; gap: 1.5rem;">
            <div>
              <label style="display: block; margin-bottom: 0.5rem; font-weight: 500; color: var(--ss-ink);">Full Name</label>
              <input type="text" name="fullName" class="input-field" placeholder="John Doe" required />
            </div>
            <div>
              <label style="display: block; margin-bottom: 0.5rem; font-weight: 500; color: var(--ss-ink);">Email Address</label>
              <input type="email" name="email" class="input-field" placeholder="john@example.com" required />
            </div>
            <div>
              <label style="display: block; margin-bottom: 0.5rem; font-weight: 500; color: var(--ss-ink);">Message</label>
              <textarea name="message" class="input-field" placeholder="How can we help you?" rows="5" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; padding: 1rem;">
              Send Message <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" x2="11" y1="2" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</div>
