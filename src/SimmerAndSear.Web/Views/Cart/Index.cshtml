@using SimmerAndSear.Web.ViewModels
@using SimmerAndSear.Contracts.Commerce
@model CartResponse

<div class="animate-fade-in">
    <div class="page-header">
        <div class="container">
            <h1 style="color: white; margin-bottom: 1rem;">Shopping Cart</h1>
            <p style="color: rgba(255,255,255,0.9); font-size: 1.15rem; max-width: 600px; margin: 0 auto;">Review your items before proceeding to checkout.</p>
        </div>
    </div>

    <div class="container" style="margin-top: 2rem;">
        <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: 1rem 1.5rem; display: flex; align-items: center; gap: 1rem;">
            <div style="color: #3b82f6; font-size: 1.5rem;">ℹ️</div>
            <p style="margin: 0; color: #1e3a8a; font-size: 0.95rem;">
                <strong>Bulk Order Policy:</strong> If your order total exceeds <strong>@Money.FormatWhole(Model.BulkOrderThreshold, Model.Currency)</strong>, it qualifies as a bulk order. An agent must be booked to finalize the order and discuss potential wholesale discounts.
            </p>
        </div>
    </div>

    <section class="section-light" style="min-height: 60vh;">
        <div class="container" style="padding: 0 1rem;">

            @if (ViewData["IsEmpty"] as bool? == true)
            {
                <div style="text-align: center; margin-top: 4rem;">
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--ss-border)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin: 0 auto 1.5rem;"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                    <h2>Your cart is empty</h2>
                    <p style="color: var(--ss-ink-muted); margin-bottom: 2rem;">Looks like you haven't added anything yet.</p>
                    <a href="/Catalogue" class="btn btn-primary">Browse Collection</a>
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 2rem;">
                    <div>
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                            <h3 style="font-size: 1.25rem; margin: 0;">Selected Products (@Model.Items.Count)</h3>
                            <button class="btn btn-outline" data-cart-clear style="padding: 0.5rem 1rem; font-size: 0.85rem; color: #ef4444; border-color: #ef4444;">Clear Cart</button>
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 1rem;">

                            @foreach (var item in Model.Items)
                            {
                                <div class="card" data-cart-line="@item.ProductId" style="display: flex; flex-wrap: wrap; gap: 1rem; padding: 1rem; align-items: center;">
                                    <a href="/Catalogue/Detail/@item.ProductId" title="@item.ImageAlt" style="display: block; width: 80px; height: 80px; background: #e5e9f0; display: flex; align-items: center; justify-content: center; text-decoration: none; border-radius: var(--ss-radius-sm); border: 2px dashed #c2c9d6; color: #4c566a; font-size: 0.7rem; text-align: center;">
                                        [Img]
                                    </a>

                                    <div style="flex: 1 1 150px;">
                                        <div style="font-size: 0.7rem; color: var(--ss-ink-muted); text-transform: uppercase; font-weight: 600;">@item.Brand @(string.IsNullOrWhiteSpace(item.Material) ? "" : "• " + item.Material)</div>
                                        <a href="/Catalogue/Detail/@item.ProductId" style="text-decoration: none; color: inherit;">
                                            <h4 style="font-size: 1rem; margin: 0.25rem 0;">@item.ProductName</h4>
                                        </a>
                                        <div style="font-weight: 700; font-size: 1.1rem; color: var(--ss-brand);">
                                            @Money.Format(item.UnitPrice, Model.Currency)
                                        </div>
                                        @if (!item.IsAvailable)
                                        {
                                            <div style="font-size: 0.75rem; color: #b91c1c; font-weight: 600; margin-top: 0.25rem;">
                                                @(item.StockQuantity == 0 ? "Currently unavailable" : $"Only {item.StockQuantity} left in stock")
                                            </div>
                                        }
                                    </div>

                                    <div style="display: flex; align-items: center; gap: 0.5rem; background: var(--ss-surface); padding: 0.25rem; border-radius: 50px;">
                                        <button data-cart-quantity="@item.ProductId" data-quantity="@(item.Quantity - 1)" aria-label="Decrease quantity of @item.ProductName" style="padding: 0.5rem; background: white; border-radius: 50%; box-shadow: var(--ss-shadow-1); border: none; cursor: pointer;">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/></svg>
                                        </button>
                                        <span style="font-weight: 600; width: 20px; text-align: center;">@item.Quantity</span>
                                        <button data-cart-quantity="@item.ProductId" data-quantity="@(item.Quantity + 1)" aria-label="Increase quantity of @item.ProductName" style="padding: 0.5rem; background: white; border-radius: 50%; box-shadow: var(--ss-shadow-1); border: none; cursor: pointer;">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                                        </button>
                                    </div>

                                    <div style="display: flex; gap: 0.5rem; width: 100%; justify-content: flex-end; border-top: 1px solid var(--ss-border); padding-top: 0.75rem; margin-top: 0.25rem;">
                                        <button style="color: var(--ss-brand); background: none; border: none; padding: 0.5rem; cursor: pointer; display: flex; align-items: center; gap: 0.25rem; font-size: 0.8rem;" title="Move to Wishlist">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                                        </button>
                                        <button data-cart-remove="@item.ProductId" aria-label="Remove @item.ProductName from cart" style="color: red; background: none; border: none; padding: 0.5rem; cursor: pointer; display: flex; align-items: center; gap: 0.25rem; font-size: 0.8rem;" title="Remove from Cart">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
                                        </button>
                                    </div>
                                </div>
                            }

                        </div>
                    </div>

                    <div>
                        <div class="card" style="padding: 1.5rem; background: var(--ss-surface-solid);">
                            <h3 style="margin-bottom: 1rem; font-size: 1.1rem;">Order Summary</h3>

                            <div style="display: flex; justify-content: space-between; margin-bottom: 1rem;">
                                <span style="color: var(--ss-ink-muted); font-size: 0.95rem;">Subtotal</span>
                                <span>@Money.Format(Model.Subtotal, Model.Currency)</span>
                            </div>

                            <div style="display: flex; justify-content: space-between; margin-bottom: 1.5rem;">
                                <span style="color: var(--ss-ink-muted); font-size: 0.95rem;">Shipping</span>
                                <span>@(Model.RequiresQuotation ? "Quoted by an agent" : Money.Format(Model.ShippingCost, Model.Currency))</span>
                            </div>

                            <div style="height: 1px; background: var(--ss-border); margin: 1.5rem 0;"></div>

                            <div style="display: flex; justify-content: space-between; margin-bottom: 2rem; font-size: 1.25rem; font-weight: 700;">
                                <span>Total</span>
                                <span>@Money.Format(Model.Total, Model.Currency)</span>
                            </div>

                            @if (Model.RequiresQuotation)
                            {
                                <p style="margin: -1rem 0 1.5rem; color: #1e3a8a; font-size: 0.85rem;">
                                    This order qualifies as a bulk order, so it will be raised as a quotation for an agent to finalise.
                                </p>
                            }

                            <a href="/Cart/Checkout" class="btn btn-primary" style="width: 100%; padding: 1rem; font-size: 1.1rem; display: block; text-align: center; text-decoration: none;">
                                @(Model.RequiresQuotation ? "Request a Quotation" : "Proceed to Checkout")
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/cart.js" asp-append-version="true"></script>
}
