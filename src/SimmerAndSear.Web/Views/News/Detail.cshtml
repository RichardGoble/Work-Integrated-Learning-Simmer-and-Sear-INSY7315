@using SimmerAndSear.Contracts.Admin
@model NewsPostResponse

<div class="animate-fade-in">
  <!-- Header -->
  <div class="page-header" style="padding: 4rem 0;">
    <h1 style="color: white; margin: 0; text-align: center; font-size: 2.5rem; font-weight: 700;">
      @Model.Title
    </h1>
  </div>
  
  <!-- Main Content -->
  <section class="section-light" style="padding-top: 3rem; min-height: 60vh;">
    <div class="container" style="max-width: 1200px; display: grid; grid-template-columns: 250px 1fr; gap: 2rem; align-items: start;">
      
      <!-- Left Sidebar -->
      <div>
        <a href="/News" style="display: inline-flex; align-items: center; gap: 0.5rem; color: var(--ss-ink); text-decoration: none; font-weight: 600; font-size: 1.1rem;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg> Back to News
        </a>
      </div>
      
      <!-- Article Card -->
      <div style="background-color: #e5e9f0; padding: 4rem; border-radius: 8px; max-width: 800px;">
        
        <h2 style="color: #2e3440; font-size: 1.75rem; line-height: 1.5; margin-top: 0; margin-bottom: 2.5rem; font-weight: 600;">
          Published @(Model.PublishedAt ?? Model.CreatedAt).ToLocalTime().ToString("d MMMM yyyy") by @Model.AuthorName
        </h2>
        
        <div style="color: #4c566a; line-height: 1.7; font-size: 1.05rem; margin-bottom: 3rem;">
          @* Bodies are plain text by design - HTML is not accepted from the editor, so each
             paragraph is rendered as text and Razor encodes it. *@
          @foreach (var paragraph in Paragraphs(Model.Body))
          {
            <p>@paragraph</p>
          }
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ImageMediaAssetId))
        {
          <div style="border-radius: var(--ss-radius); overflow: hidden;">
            <img src="@Model.ImageUrl" alt="@Model.Title" loading="lazy" style="width: 100%; height: auto; display: block;" />
          </div>
        }

      </div>
      
    </div>
  </section>
</div>

@functions {
    static IEnumerable<string> Paragraphs(string body) =>
        (body ?? string.Empty)
            .Replace("\r\n", "\n")
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
}
