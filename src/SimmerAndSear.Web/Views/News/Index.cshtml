@using SimmerAndSear.Contracts.Admin
@using SimmerAndSear.Contracts.Paging
@model Page<NewsPostResponse>

<div class="animate-fade-in">
  <div class="page-header">
    <div class="container">
      <h1 style="color: white; margin-bottom: 1rem;">News</h1>
      <p style="color: rgba(255,255,255,0.9); font-size: 1.15rem;">The latest updates, stories, and culinary inspiration from Simmer & Sear.</p>
    </div>
  </div>
  
  <section class="section-light">
    <div class="container" style="max-width: 900px;">

      @if (Model.Items.Count == 0)
      {
        <div style="text-align: center; padding: 6rem 0;">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--ss-border)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin: 0 auto 1.5rem;"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6Z"/></svg>
          <h2 style="font-weight: 400;">No articles yet</h2>
          <p style="color: var(--ss-ink-muted);">Check back soon for updates from the kitchen.</p>
        </div>
      }
      else
      {
        <div style="display: flex; flex-direction: column; gap: 3rem;">
          @foreach (var post in Model.Items)
          {
            <article class="card" style="padding: 3rem; border-left: 4px solid var(--ss-brand); background: var(--ss-surface);">
              <div style="display: flex; align-items: center; gap: 0.75rem; font-size: 0.9rem; margin-bottom: 1.5rem; color: var(--ss-brand); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg> @(post.PublishedAt ?? post.CreatedAt).ToLocalTime().ToString("d MMMM yyyy")
              </div>
              <h2 style="margin-bottom: 1.5rem; font-size: 2rem; color: var(--ss-ink); margin-top: 0;">@post.Title</h2>
              <p style="color: var(--ss-ink-muted); font-size: 1.125rem; line-height: 1.8; margin-bottom: 2rem;">
                @Excerpt(post.Body)
              </p>
              <a href="/news/@post.Id" class="btn btn-outline" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; font-size: 0.9rem; text-decoration: none;">
                Read Full Article <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </article>
          }
        </div>

        var pager = new SimmerAndSear.Web.ViewModels.Components.PaginationVm(Model.PageNumber, Model.TotalPages, "/news");
        <partial name="_Pagination" model="pager" />
      }

    </div>
  </section>
  
  <section class="section-accent" style="text-align: center;">
    <div class="container">
      <h2 style="margin-bottom: 1.5rem; color: var(--ss-ink);">Subscribe to our Newsletter</h2>
      <p style="color: var(--ss-ink-muted); margin-bottom: 2rem; font-size: 1.125rem;">Get the latest updates directly in your inbox.</p>
      <div style="display: flex; max-width: 500px; margin: 0 auto; gap: 1rem;">
        <input type="email" class="input-field" placeholder="Enter your email address" style="flex: 1;" />
        <button class="btn" style="background-color: var(--ss-ink); color: white; padding: 0.75rem 2rem; font-weight: 600; border-radius: var(--ss-radius-sm); border: none; cursor: pointer;">Subscribe</button>
      </div>
    </div>
  </section>
</div>

@functions {
    // Bodies are plain text by design, so a substring is safe - there is no markup to cut
    // through. Trimmed at a word boundary so the preview does not end mid-word.
    static string Excerpt(string body)
    {
        const int limit = 220;
        var text = (body ?? string.Empty).Trim();

        if (text.Length <= limit) return text;

        var cut = text.LastIndexOf(' ', limit);
        return text[..(cut < 80 ? limit : cut)] + "\u2026";
    }
}
