@using SimmerAndSear.Domain.Enums
@model SimmerAndSear.Contracts.Paging.Page<SimmerAndSear.Domain.Entities.AuditLogEntry>
@{
    ViewData["Title"] = "Audit log";
}

<div class="animate-fade-in">
    <div class="page-header">
        <div class="container">
            <h1 style="color: white; margin-bottom: 1rem;">Audit Log</h1>
            <p style="color: rgba(255,255,255,0.9); font-size: 1.15rem; max-width: 640px; margin: 0 auto;">
                An append-only record of every change and every refused request.
            </p>
        </div>
    </div>

    <section class="section-light">
        <div class="container">

            <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
                <a href="/Admin" style="display: inline-flex; align-items: center; gap: 0.5rem; color: var(--ss-ink); text-decoration: none; font-weight: 600;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
                    Back to dashboard
                </a>
                <span style="color: var(--ss-ink-muted); font-size: 0.9rem;">
                    @Model.Total event@(Model.Total == 1 ? "" : "s") &middot; page @Model.PageNumber of @(Model.TotalPages == 0 ? 1 : Model.TotalPages)
                </span>
            </div>

            @if (Model.Items.Count == 0)
            {
                <div class="card" style="text-align: center; padding: 5rem 2rem;">
                    <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="var(--ss-border)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin: 0 auto 1.25rem;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
                    <h2 style="font-weight: 400; margin-bottom: 0.5rem;">No events recorded</h2>
                    <p style="color: var(--ss-ink-muted); margin: 0;">Actions taken in the console will appear here.</p>
                </div>
            }
            else
            {
                <div class="card" style="padding: 0; overflow: hidden;">
                    <div style="overflow-x: auto;">
                        <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
                            <thead>
                                <tr style="background: var(--ss-surface-solid); text-align: left;">
                                    <th style="padding: 0.9rem 1.25rem; font-weight: 600; color: var(--ss-ink); white-space: nowrap;">When</th>
                                    <th style="padding: 0.9rem 1.25rem; font-weight: 600; color: var(--ss-ink);">Who</th>
                                    <th style="padding: 0.9rem 1.25rem; font-weight: 600; color: var(--ss-ink);">Action</th>
                                    <th style="padding: 0.9rem 1.25rem; font-weight: 600; color: var(--ss-ink);">Entity</th>
                                    <th style="padding: 0.9rem 1.25rem; font-weight: 600; color: var(--ss-ink);">Details</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var entry in Model.Items)
                            {
                                var denied = entry.Action == AuditAction.AccessDenied;

                                <tr style="border-top: 1px solid var(--ss-border); @(denied ? "background: #fef2f2;" : "")">
                                    <td style="padding: 0.9rem 1.25rem; color: var(--ss-ink-muted); white-space: nowrap;">
                                        @entry.OccurredAt.ToLocalTime().ToString("d MMM yyyy")<br />
                                        <span style="font-size: 0.8rem;">@entry.OccurredAt.ToLocalTime().ToString("HH:mm:ss")</span>
                                    </td>
                                    <td style="padding: 0.9rem 1.25rem;">
                                        <div style="font-weight: 600; color: var(--ss-ink);">@entry.ActorName</div>
                                        <div style="font-size: 0.8rem; color: var(--ss-ink-muted);">@entry.ActorRole</div>
                                    </td>
                                    <td style="padding: 0.9rem 1.25rem;">
                                        @* A refusal is the entry a marker looks for, so it is the one that stands out. *@
                                        <span style="display: inline-block; padding: 0.2rem 0.6rem; border-radius: 50px; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; @Badge(entry.Action)">
                                            @(denied ? "Access denied" : entry.Action.ToString())
                                        </span>
                                    </td>
                                    <td style="padding: 0.9rem 1.25rem; color: var(--ss-ink-muted); white-space: nowrap;">
                                        @entry.EntityType
                                    </td>
                                    <td style="padding: 0.9rem 1.25rem; color: var(--ss-ink); max-width: 460px;">
                                        @entry.Summary
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>

                var pager = new SimmerAndSear.Web.ViewModels.Components.PaginationVm(
                    Model.PageNumber, Model.TotalPages, "/Admin/Audit");
                <partial name="_Pagination" model="pager" />
            }

        </div>
    </section>
</div>

@functions {
    // Colour carries the meaning at a glance: refusals red, destruction amber,
    // everything else neutral.
    static string Badge(AuditAction action) => action switch
    {
        AuditAction.AccessDenied => "background: #fee2e2; color: #b91c1c;",
        AuditAction.Delete => "background: #fef3c7; color: #92400e;",
        AuditAction.Create => "background: #dcfce7; color: #166534;",
        AuditAction.Login or AuditAction.Logout => "background: #e0e7ff; color: #3730a3;",
        _ => "background: var(--ss-surface-solid); color: var(--ss-ink);"
    };
}
