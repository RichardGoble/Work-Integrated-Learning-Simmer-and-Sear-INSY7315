@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="animate-fade-in section-light" style="min-height: 100vh;">
    <div class="container" style="padding: 3rem 1.5rem; max-width: 1400px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 3rem;">
            <h2 style="font-size: 2.5rem; margin: 0;">Admin Dashboard</h2>
            <button class="btn btn-outline" style="color: var(--ss-brand); border-color: var(--ss-brand); display: flex; align-items: center; gap: 0.5rem;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg> Logout
            </button>
        </div>

        <div style="display: flex; gap: 0.75rem; margin-bottom: 2rem; border-bottom: 1px solid var(--ss-border); padding-bottom: 1rem; overflow-x: auto; flex-wrap: nowrap; white-space: nowrap;">
            <button id="btn-orders" class="btn btn-secondary admin-tab-btn" onclick="showTab('orders')">Manage Orders <span style="background: var(--ss-brand); color: white; padding: 0.1rem 0.5rem; border-radius: 50px; font-size: 0.75rem; margin-left: 0.5rem;">[#]</span></button>
            <button id="btn-bulk" class="btn btn-outline admin-tab-btn" onclick="showTab('bulk')">Bulk Requests <span style="background: var(--ss-brand); color: white; padding: 0.1rem 0.5rem; border-radius: 50px; font-size: 0.75rem; margin-left: 0.5rem;">[#]</span></button>
            <button id="btn-inquiries" class="btn btn-outline admin-tab-btn" onclick="showTab('inquiries')">Manage Inquiries <span style="background: var(--ss-brand); color: white; padding: 0.1rem 0.5rem; border-radius: 50px; font-size: 0.75rem; margin-left: 0.5rem;">[#]</span></button>
            <button id="btn-products" class="btn btn-outline admin-tab-btn" onclick="showTab('products')">Manage Catalogue</button>
            <button id="btn-attributes" class="btn btn-outline admin-tab-btn" onclick="showTab('attributes')">Manage Attributes</button>
            <button id="btn-journal" class="btn btn-outline admin-tab-btn" onclick="showTab('journal')">Manage Journal</button>
            <button id="btn-gallery" class="btn btn-outline admin-tab-btn" onclick="showTab('gallery')">Manage Gallery</button>
            <button id="btn-reviews" class="btn btn-outline admin-tab-btn" onclick="showTab('reviews')">Manage Reviews</button>
            <button id="btn-partners" class="btn btn-outline admin-tab-btn" onclick="showTab('partners')">Manage Partners</button>
            <button id="btn-settings" class="btn btn-outline admin-tab-btn" onclick="showTab('settings')">Settings</button>
            <button id="btn-admins" class="btn btn-outline admin-tab-btn" onclick="showTab('admins')">Manage Admins</button>
            <button id="btn-audit" class="btn btn-outline admin-tab-btn" onclick="showTab('audit')">Audit Log</button>
        </div>

        <div id="tab-orders" class="admin-tab-content" style="display: block;">
            <h3 style="margin-bottom: 1.5rem;">Manage Orders</h3>
            <div style="display: grid; grid-template-columns: 1fr; gap: 1.5rem;">
                <div class="card" style="padding: 2rem; display: flex; flex-direction: column; gap: 1rem; border-left: 4px solid #10b981;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div style="display: flex; gap: 1rem; align-items: center;">
                            <div style="padding: 0.75rem; background: var(--ss-surface-solid); border-radius: 50%;">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                            </div>
                            <div>
                                <h4 style="margin: 0 0 0.25rem 0; font-size: 1.25rem; color: var(--ss-ink);">Order #[Order ID]</h4>
                                <div style="color: var(--ss-ink-muted); font-size: 0.9rem;">
                                    <strong>[Customer Name]</strong> � [Order Date] � [Total Price]
                                </div>
                            </div>
                        </div>
                        <div style="display: flex; gap: 1rem; align-items: center;">
                            <select class="input-field" style="padding: 0.5rem; width: auto;"><option>[Status]</option></select>
                            <button style="color: #ef4444; background: none; border: none; cursor: pointer;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg></button>
                        </div>
                    </div>
                    <div style="background: var(--ss-surface-solid); padding: 1rem; border-radius: var(--ss-radius-sm); font-size: 0.95rem;">
                        <strong>Items:</strong> [Qty]x [Product Name], [Qty]x [Product Name]
                    </div>
                    <div style="padding: 1rem; border: 1px solid var(--ss-border); border-radius: var(--ss-radius-sm); font-size: 0.95rem;">
                        <strong>Shipping Address:</strong><br/>[Address Line 1], [City], [Postal Code]
                    </div>
                </div>
            </div>
        </div>

        <div id="tab-bulk" class="admin-tab-content" style="display: none;">
            <h3 style="margin-bottom: 1.5rem;">Bulk Requests</h3>
            <div style="display: grid; grid-template-columns: 1fr; gap: 1.5rem;">
                <div class="card" style="padding: 2rem; display: flex; flex-direction: column; gap: 1rem; border-left: 4px solid #f59e0b;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div style="display: flex; gap: 1rem; align-items: center;">
                            <div style="padding: 0.75rem; background: var(--ss-surface-solid); border-radius: 50%;">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg>
                            </div>
                            <div>
                                <h4 style="margin: 0 0 0.25rem 0; font-size: 1.25rem; color: var(--ss-ink);">Request #[Request ID] - [Date]</h4>
                                <div style="color: var(--ss-ink-muted); font-size: 0.9rem;">
                                    <strong>[Customer Name]</strong> ([Company Name]) � <span style="color: #3b82f6">[Email Address]</span>
                                </div>
                            </div>
                        </div>
                        <div style="display: flex; gap: 1rem; align-items: center;">
                            <select class="input-field" style="padding: 0.5rem; width: auto;"><option>[Status]</option></select>
                            <button style="color: #ef4444; background: none; border: none; cursor: pointer;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg></button>
                        </div>
                    </div>
                    <div style="background: var(--ss-surface-solid); padding: 1rem; border-radius: var(--ss-radius-sm);">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                            <h5 style="margin: 0;">Requested Items (Est. Total: [Est Total])</h5>
                            <button class="btn btn-outline" style="padding: 0.5rem 1rem; font-size: 0.85rem;">View Lookbook (PDF)</button>
                        </div>
                        <ul style="margin: 0; padding-left: 1.5rem; font-size: 0.9rem;">
                            <li>[Qty]x [Product Name]</li>
                        </ul>
                    </div>
                    <div style="padding: 1rem; border: 1px solid var(--ss-border); border-radius: var(--ss-radius-sm); font-size: 0.95rem;">
                        <strong>Customer Message:</strong><br/>[Message Content]
                    </div>
                </div>
            </div>
        </div>

        <div id="tab-inquiries" class="admin-tab-content" style="display: none;">
            <h3 style="margin-bottom: 1.5rem;">Manage Inquiries</h3>
            <div style="display: grid; grid-template-columns: 1fr; gap: 1.5rem;">
                <div class="card" style="padding: 2rem; display: flex; flex-direction: column; gap: 1rem; border-left: 4px solid var(--ss-brand);">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div style="display: flex; gap: 1rem; align-items: center;">
                            <div style="padding: 0.75rem; background: var(--ss-surface-solid); border-radius: 50%;">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--ss-brand)" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                            </div>
                            <div>
                                <h4 style="margin: 0 0 0.25rem 0; font-size: 1.25rem; color: var(--ss-ink);">[Inquiry Type] from [Name]</h4>
                                <div style="color: var(--ss-ink-muted); font-size: 0.9rem;">
                                    <span style="color: #3b82f6">[Email]</span> � [Date]
                                </div>
                            </div>
                        </div>
                        <button style="color: #ef4444; background: none; border: none; cursor: pointer;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg></button>
                    </div>
                    <div style="padding: 1rem; border: 1px solid var(--ss-border); border-radius: var(--ss-radius-sm); font-size: 0.95rem;">
                        [Message Content]
                    </div>
                </div>
            </div>
        </div>

        <div id="tab-products" class="admin-tab-content" style="display: none;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
                <h3 style="margin: 0;">Manage Catalogue</h3>
                <button class="btn btn-primary" style="display: flex; align-items: center; gap: 0.5rem;" onclick="document.getElementById('form-add-product').style.display='block'; document.getElementById('products-grid').style.display='none';">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Add New Product
                </button>
            </div>

            <!-- Add New Product Form -->
            <div id="form-add-product" class="card" style="padding: 3rem; margin-bottom: 2rem; border-top: 4px solid var(--ss-brand); display: none;">
                <h3 style="margin-bottom: 2rem;">Add New Product</h3>
                <form style="display: flex; flex-direction: column; gap: 2rem;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
                        <div>
                            <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Product Name</label>
                            <input type="text" class="input-field" required />
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Product Images</label>
                            <button type="button" class="btn btn-outline" style="display: flex; align-items: center; gap: 0.5rem; width: fit-content;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Add Image</button>
                            <small style="color: var(--ss-ink-muted); display: block; margin-top: 0.5rem;">Select image files (under 2MB)</small>
                        </div>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1.5rem;">
                        <div>
                            <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Price (R)</label>
                            <input type="number" class="input-field" required />
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Product Type</label>
                            <select class="input-field"><option>[Select Type]</option></select>
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Material</label>
                            <select class="input-field"><option>[Select Material]</option></select>
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Brand</label>
                            <select class="input-field"><option>[Select Brand]</option></select>
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Range</label>
                            <select class="input-field"><option>[Select Range]</option></select>
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Size</label>
                            <select class="input-field"><option>[Select Size]</option></select>
                        </div>
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Description</label>
                        <textarea class="input-field" rows="4" required></textarea>
                    </div>
                    <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 1rem;">
                        <button type="button" class="btn btn-outline" onclick="document.getElementById('form-add-product').style.display='none'; document.getElementById('products-grid').style.display='block';">Cancel</button>
                        <button type="button" class="btn btn-primary">Save Product</button>
                    </div>
                </form>
            </div>

            <!-- Product Grid & Filter -->
            <div id="products-grid">
                <div class="card" style="margin-bottom: 2rem; padding: 2rem; border-top: 4px solid var(--ss-brand);">
                    <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--ss-brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                        <h3 style="margin: 0; font-size: 1.5rem;">Filter Products</h3>
                    </div>
                    
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem;">
                        <div>
                            <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--ss-ink); font-size: 0.9rem;">Search keyword</label>
                            <div style="display: flex; align-items: center; background: var(--ss-surface-solid); padding: 0.5rem 1rem; border-radius: var(--ss-radius-sm);">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--ss-ink-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.5rem;"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                                <input type="text" placeholder="Search..." style="flex: 1; border: none; background: transparent; outline: none; color: var(--ss-ink); font-size: 1rem;" />
                            </div>
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--ss-ink); font-size: 0.9rem;">Product Type</label>
                            <select class="input-field" style="background: var(--ss-surface-solid);"><option value="">[All Types]</option></select>
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--ss-ink); font-size: 0.9rem;">Material</label>
                            <select class="input-field" style="background: var(--ss-surface-solid);"><option value="">[All Materials]</option></select>
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--ss-ink); font-size: 0.9rem;">Brand</label>
                            <select class="input-field" style="background: var(--ss-surface-solid);"><option value="">[All Brands]</option></select>
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--ss-ink); font-size: 0.9rem;">Range</label>
                            <select class="input-field" style="background: var(--ss-surface-solid);"><option value="">[Product Range]</option></select>
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--ss-ink); font-size: 0.9rem;">Size</label>
                            <select class="input-field" style="background: var(--ss-surface-solid);"><option value="">[Size]</option></select>
                        </div>
                    </div>
                    
                    <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 2rem;">
                        <button class="btn btn-outline" style="padding: 0.5rem 1.5rem;">Clear Filters</button>
                        <button class="btn btn-primary" style="padding: 0.5rem 1.5rem;">Filter</button>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
                    <div class="card" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                            <div style="width: 80px; height: 80px; background: #e5e9f0; display: flex; align-items: center; justify-content: center; border-radius: var(--ss-radius-sm); border: 2px dashed #c2c9d6; color: #4c566a; font-size: 0.7rem;">[Img]</div>
                            <div style="display: flex; gap: 0.5rem;">
                                <button style="color: #3b82f6; background: none; border: none; cursor: pointer; padding: 0.5rem;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg></button>
                                <button style="color: #ef4444; background: none; border: none; cursor: pointer; padding: 0.5rem;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg></button>
                            </div>
                        </div>
                        <div>
                            <div style="font-size: 0.75rem; color: var(--ss-ink-muted); text-transform: uppercase;">[Brand] • [Material]</div>
                            <h4 style="margin: 0.25rem 0; font-size: 1.1rem;">[Product Title]</h4>
                            <div style="font-weight: bold; color: var(--ss-brand);">[Price]</div>
                            <div style="font-size: 0.85rem; color: var(--ss-ink-muted); margin-top: 0.5rem;">Type: [Type] | Range: [Range] | Size: [Size]</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="tab-attributes" class="admin-tab-content" style="display: none;">
            <h3 style="margin-bottom: 2rem;">Manage Product Attributes</h3>
            
            <div class="card" style="padding: 2rem; margin-bottom: 2rem; max-width: 600px;">
                <label style="display: block; margin-bottom: 0.5rem; font-weight: 500; font-size: 0.9rem;">Attribute Type</label>
                <select class="input-field" style="margin-bottom: 1.5rem;"><option>All Attributes</option></select>
                <div style="display: flex; justify-content: flex-end; gap: 1rem;">
                    <button class="btn" style="background-color: #707b8e; color: white; border: none; padding: 0.5rem 1.5rem; border-radius: var(--ss-radius-sm); font-weight: 500;">Clear filters</button>
                    <button class="btn" style="background-color: #707b8e; color: white; border: none; padding: 0.5rem 1.5rem; border-radius: var(--ss-radius-sm); font-weight: 500;">Filter</button>
                </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                
                <!-- Product Types -->
                <div class="card" style="padding: 2rem;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start;">
                        <div>
                            <h4 style="margin: 0 0 1.5rem 0; font-size: 0.95rem; font-weight: 600;">Current Product Types</h4>
                            <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
                                <div style="display: flex; align-items: center; gap: 0.5rem; background: #f1f5f9; padding: 0.4rem 0.8rem; border-radius: 50px; font-size: 0.85rem; color: #334155;">[Product Type] <button style="background: none; border: none; padding: 0; cursor: pointer; color: #ef4444; display: flex;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/></svg></button></div>
                            </div>
                        </div>
                        <div>
                            <h4 style="margin: 0 0 1.5rem 0; font-size: 0.95rem; font-weight: 500; color: #64748b;">New Value</h4>
                            <div style="display: flex; gap: 1rem;">
                                <input type="text" class="input-field" placeholder="e.g. Strainer" style="flex: 1;" />
                                <button class="btn btn-primary" style="padding: 0 2rem; border-radius: var(--ss-radius-sm);">Add</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Materials -->
                <div class="card" style="padding: 2rem;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start;">
                        <div>
                            <h4 style="margin: 0 0 1.5rem 0; font-size: 0.95rem; font-weight: 600;">Current Materials</h4>
                            <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
                                <div style="display: flex; align-items: center; gap: 0.5rem; background: #f1f5f9; padding: 0.4rem 0.8rem; border-radius: 50px; font-size: 0.85rem; color: #334155;">[Material] <button style="background: none; border: none; padding: 0; cursor: pointer; color: #ef4444; display: flex;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/></svg></button></div>
                            </div>
                        </div>
                        <div>
                            <h4 style="margin: 0 0 1.5rem 0; font-size: 0.95rem; font-weight: 500; color: #64748b;">New Value</h4>
                            <div style="display: flex; gap: 1rem;">
                                <input type="text" class="input-field" placeholder="e.g. Ceramic" style="flex: 1;" />
                                <button class="btn btn-primary" style="padding: 0 2rem; border-radius: var(--ss-radius-sm);">Add</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Brands -->
