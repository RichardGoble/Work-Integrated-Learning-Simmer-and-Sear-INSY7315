@model SimmerAndSear.Web.ViewModels.AdminDashboardVm
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="animate-fade-in section-light" style="min-height: 100vh;">
    <div class="container" style="padding: 3rem 1.5rem; max-width: 1400px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 3rem;">
            <h2 style="font-size: 2.5rem; margin: 0;">Admin Dashboard</h2>
            <form asp-controller="Auth" asp-action="Logout" method="post"><button type="submit" class="btn btn-outline" style="color: var(--ss-brand); border-color: var(--ss-brand); display: flex; align-items: center; gap: 0.5rem;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg> Logout
            </button></form>
        </div>

        @if (TempData["Error"] is not null)
        {
            <div class="alert alert-danger" style="margin-bottom: 2rem; padding: 1rem 1.5rem; background: #fee2e2; border-left: 4px solid #ef4444; color: #b91c1c; border-radius: var(--ss-radius-sm);">
                @TempData["Error"]
            </div>
        }

        <div style="display: flex; gap: 0.75rem; margin-bottom: 2rem; border-bottom: 1px solid var(--ss-border); padding-bottom: 1rem; overflow-x: auto; flex-wrap: nowrap; white-space: nowrap;">
            <button type="button" id="btn-orders" class="btn btn-secondary admin-tab-btn" data-click-action="action1">Manage Orders <span style="background: var(--ss-brand); color: white; padding: 0.1rem 0.5rem; border-radius: 50px; font-size: 0.75rem; margin-left: 0.5rem;">@Model.CheckoutOrders.Count</span></button>
            <button type="button" id="btn-bulk" class="btn btn-outline admin-tab-btn" data-click-action="action2">Bulk Requests <span style="background: var(--ss-brand); color: white; padding: 0.1rem 0.5rem; border-radius: 50px; font-size: 0.75rem; margin-left: 0.5rem;">@Model.BulkRequests.Count</span></button>
            <button type="button" id="btn-inquiries" class="btn btn-outline admin-tab-btn" data-click-action="action3">Manage Inquiries <span style="background: var(--ss-brand); color: white; padding: 0.1rem 0.5rem; border-radius: 50px; font-size: 0.75rem; margin-left: 0.5rem;">@(Model.Inquiries.Count + Model.Bookings.Count)</span></button>
@if (Model.ShowMasterSections) {
            <button type="button" id="btn-products" class="btn btn-outline admin-tab-btn" data-click-action="action4">Manage Catalogue</button>
            <button type="button" id="btn-attributes" class="btn btn-outline admin-tab-btn" data-click-action="action5">Manage Attributes</button>
            <button type="button" id="btn-journal" class="btn btn-outline admin-tab-btn" data-click-action="action6">Manage Journal</button>
            <button type="button" id="btn-gallery" class="btn btn-outline admin-tab-btn" data-click-action="action7">Manage Gallery</button>
}
            <button type="button" id="btn-reviews" class="btn btn-outline admin-tab-btn" data-click-action="action8">Manage Reviews</button>
            <button type="button" id="btn-partners" class="btn btn-outline admin-tab-btn" data-click-action="action9">Manage Partners</button>
@if (Model.ShowMasterSections) {
            <button type="button" id="btn-settings" class="btn btn-outline admin-tab-btn" data-click-action="action10">Settings</button>
}
@if (User.IsInRole("MasterAdmin")) {
            <button type="button" id="btn-admins" class="btn btn-outline admin-tab-btn" data-click-action="action11">Manage Admins</button>
            <a class="btn btn-outline" href="/Admin/Audit">Audit log</a>
}
        </div>

        <!-- 1. Manage Orders Tab -->
        <div id="tab-orders" class="admin-tab-content" style="display: block;">
            <h3 style="margin-bottom: 1.5rem;">Manage Orders</h3>
            <div style="display: grid; grid-template-columns: 1fr; gap: 1.5rem;">
                @if (Model.CheckoutOrders.Count == 0)
                {
                    <div class="card" style="padding: 2.5rem; text-align: center; color: var(--ss-ink-muted);">
                        No checkout orders found.
                    </div>
                }
                @foreach (var order in Model.CheckoutOrders)
                {
                    <div class="card" style="padding: 2rem; display: flex; flex-direction: column; gap: 1rem; border-left: 4px solid #10b981;">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                            <div style="display: flex; gap: 1rem; align-items: center;">
                                <div style="padding: 0.75rem; background: var(--ss-surface-solid); border-radius: 50%;">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                                </div>
                                <div>
                                    <h4 style="margin: 0 0 0.25rem 0; font-size: 1.25rem; color: var(--ss-ink);">Order #@order.OrderReference</h4>
                                    <div style="color: var(--ss-ink-muted); font-size: 0.9rem;">
                                        <strong>@(order.ShippingDetails?.FullName ?? "Customer")</strong> &bull; @order.PlacedAt.ToString("d MMM yyyy") &bull; @order.Currency @order.Total.ToString("N2")
                                    </div>
                                </div>
                            </div>
                            <div style="display: flex; gap: 1rem; align-items: center;">
                                <form method="post" action="/Admin/Orders/@order.Id/status" style="margin: 0;">
                                    @Html.AntiForgeryToken()
                                    <select name="status" class="input-field" style="padding: 0.5rem; width: auto;" data-submit-on-change>
                                        @foreach (var s in Enum.GetValues<SimmerAndSear.Domain.Enums.OrderStatus>())
                                        {
                                            <option value="@s" selected="@(s == order.Status)">@s</option>
                                        }
                                    </select>
                                </form>
                                <form method="post" action="/Admin/Orders/@order.Id/delete" data-confirm="Are you sure you want to delete this order?" style="margin: 0;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" style="color: #ef4444; background: none; border: none; cursor: pointer;" title="Delete Order"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg></button>
                                </form>
                            </div>
                        </div>
                        <div style="background: var(--ss-surface-solid); padding: 1rem; border-radius: var(--ss-radius-sm); font-size: 0.95rem;">
                            <strong>Items:</strong> @string.Join(", ", order.Items.Select(i => $"{i.Quantity}x {i.ProductName}"))
                        </div>
                        <div style="padding: 1rem; border: 1px solid var(--ss-border); border-radius: var(--ss-radius-sm); font-size: 0.95rem;">
                            <strong>Shipping Address:</strong><br/>
                            @if (order.ShippingDetails is not null)
                            {
                                @($"{order.ShippingDetails.AddressLine}, {order.ShippingDetails.City}, {order.ShippingDetails.PostalCode}")
                            }
                            else
                            {
                                <span>No shipping address provided</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- 2. Bulk Requests Tab -->
        <div id="tab-bulk" class="admin-tab-content" style="display: none;">
            <h3 style="margin-bottom: 1.5rem;">Bulk Requests</h3>
            <div style="display: grid; grid-template-columns: 1fr; gap: 1.5rem;">
                @if (Model.BulkRequests.Count == 0)
                {
                    <div class="card" style="padding: 2.5rem; text-align: center; color: var(--ss-ink-muted);">
                        No bulk quote requests found.
                    </div>
                }
                @foreach (var req in Model.BulkRequests)
                {
                    <div class="card" style="padding: 2rem; display: flex; flex-direction: column; gap: 1rem; border-left: 4px solid #f59e0b;">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                            <div style="display: flex; gap: 1rem; align-items: center;">
                                <div style="padding: 0.75rem; background: var(--ss-surface-solid); border-radius: 50%;">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg>
                                </div>
                                <div>
                                    <h4 style="margin: 0 0 0.25rem 0; font-size: 1.25rem; color: var(--ss-ink);">Request #@req.OrderReference - @req.PlacedAt.ToString("d MMM yyyy")</h4>
                                    <div style="color: var(--ss-ink-muted); font-size: 0.9rem;">
                                        <strong>@(req.ShippingDetails?.FullName ?? "Trade Client")</strong> &bull; <span style="color: #3b82f6">@(req.ShippingDetails?.Email ?? req.ClientId)</span>
                                    </div>
                                </div>
                            </div>
                            <div style="display: flex; gap: 1rem; align-items: center;">
                                <form method="post" action="/Admin/Orders/@req.Id/status" style="margin: 0;">
                                    @Html.AntiForgeryToken()
                                    <select name="status" class="input-field" style="padding: 0.5rem; width: auto;" data-submit-on-change>
                                        @foreach (var s in Enum.GetValues<SimmerAndSear.Domain.Enums.OrderStatus>())
                                        {
                                            <option value="@s" selected="@(s == req.Status)">@s</option>
                                        }
                                    </select>
                                </form>
                                <form method="post" action="/Admin/Orders/@req.Id/delete" data-confirm="Are you sure you want to delete this bulk request?" style="margin: 0;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" style="color: #ef4444; background: none; border: none; cursor: pointer;" title="Delete Request"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg></button>
                                </form>
                            </div>
                        </div>
                        <div style="background: var(--ss-surface-solid); padding: 1rem; border-radius: var(--ss-radius-sm);">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                                <h5 style="margin: 0;">Requested Items (Est. Total: @req.Currency @req.Total.ToString("N2"))</h5>
                                <a href="/api/admin/orders/@req.Id/quotation" target="_blank" rel="noopener" class="btn btn-outline" style="padding: 0.5rem 1rem; font-size: 0.85rem; text-decoration: none;">View Quotation (PDF)</a>
                            </div>
                            <ul style="margin: 0; padding-left: 1.5rem; font-size: 0.9rem;">
                                @foreach (var item in req.Items)
                                {
                                    <li>@item.Quantity x @item.ProductName (@req.Currency @item.UnitPrice.ToString("N2"))</li>
                                }
                            </ul>
                        </div>
                        <div style="padding: 1rem; border: 1px solid var(--ss-border); border-radius: var(--ss-radius-sm); font-size: 0.95rem;">
                            <strong>Delivery / Contact Details:</strong><br/>
                            @if (req.ShippingDetails is not null)
                            {
                                @($"{req.ShippingDetails.AddressLine}, {req.ShippingDetails.City}, {req.ShippingDetails.PostalCode}")
                            }
                            else
                            {
                                <span>Bulk inquiry received for pricing and delivery estimate.</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- 3. Manage Inquiries Tab -->
        <div id="tab-inquiries" class="admin-tab-content" style="display: none;">
            <h3 style="margin-bottom: 1.5rem;">Contact Inquiries (@Model.Inquiries.Count)</h3>
            <div style="display: grid; grid-template-columns: 1fr; gap: 1.5rem; margin-bottom: 3rem;">
                @if (Model.Inquiries.Count == 0)
                {
                    <div class="card" style="padding: 2.5rem; text-align: center; color: var(--ss-ink-muted);">
                        No contact inquiries found.
                    </div>
                }
                @foreach (var inq in Model.Inquiries)
                {
                    <div class="card" style="padding: 2rem; display: flex; flex-direction: column; gap: 1rem; border-left: 4px solid var(--ss-brand);">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
                            <div style="display: flex; gap: 1rem; align-items: center;">
                                <div style="padding: 0.75rem; background: var(--ss-surface-solid); border-radius: 50%;">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--ss-brand)" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                                </div>
                                <div>
                                    <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                                        <h4 style="margin: 0; font-size: 1.25rem; color: var(--ss-ink);">@inq.InquiryType from @inq.FullName</h4>
                                        <span style="font-size: 0.75rem; padding: 0.15rem 0.5rem; border-radius: 4px; background: rgba(242, 93, 7, 0.1); color: var(--ss-brand); font-weight: 600;">@inq.Status</span>
                                        <span style="font-size: 0.75rem; padding: 0.15rem 0.5rem; border-radius: 4px; background: @(inq.NotificationStatus == SimmerAndSear.Domain.Enums.ContactNotificationStatus.Sent ? "#ecfdf5; color: #065f46" : inq.NotificationStatus == SimmerAndSear.Domain.Enums.ContactNotificationStatus.Failed ? "#fee2e2; color: #991b1b" : "#fef3c7; color: #92400e"); font-weight: 600;">Email: @inq.NotificationStatus</span>
                                    </div>
                                    <div style="color: var(--ss-ink-muted); font-size: 0.9rem; margin-top: 0.25rem;">
                                        <a href="mailto:@inq.Email" style="color: #3b82f6">@inq.Email</a>
                                        @if (!string.IsNullOrWhiteSpace(inq.Phone)) { <span>&bull; @inq.Phone</span> }
                                        &bull; @inq.SubmittedAt.ToString("d MMM yyyy, HH:mm")
                                        @if (!string.IsNullOrWhiteSpace(inq.HandledBy)) { <span>&bull; Handled by: @inq.HandledBy</span> }
                                    </div>
                                </div>
                            </div>
                            <form method="post" action="/Admin/Inquiries/@inq.Id/delete" data-confirm="Are you sure you want to delete this inquiry?" style="margin: 0;">
                                @Html.AntiForgeryToken()
                                <button type="submit" style="color: #ef4444; background: none; border: none; cursor: pointer;" title="Delete Inquiry"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg></button>
                            </form>
                        </div>
                        <div style="padding: 1rem; border: 1px solid var(--ss-border); border-radius: var(--ss-radius-sm); font-size: 0.95rem;">
                            @inq.Message
                        </div>
                    </div>
                }
            </div>

            <h3 style="margin-bottom: 1.5rem;">Consultation Bookings (@Model.Bookings.Count)</h3>
            <div style="display: grid; grid-template-columns: 1fr; gap: 1.5rem;">
                @if (Model.Bookings.Count == 0)
                {
                    <div class="card" style="padding: 2.5rem; text-align: center; color: var(--ss-ink-muted);">
                        No consultation bookings found.
                    </div>
                }
                @foreach (var b in Model.Bookings)
                {
                    <div class="card" style="padding: 2rem; display: flex; flex-direction: column; gap: 1rem; border-left: 4px solid #3b82f6;">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
                            <div style="display: flex; gap: 1rem; align-items: center;">
                                <div style="padding: 0.75rem; background: var(--ss-surface-solid); border-radius: 50%;">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                </div>
                                <div>
                                    <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                                        <h4 style="margin: 0; font-size: 1.25rem; color: var(--ss-ink);">Consultation: @b.ClientName</h4>
                                        <span style="font-size: 0.75rem; padding: 0.15rem 0.5rem; border-radius: 4px; background: rgba(59, 130, 246, 0.1); color: #2563eb; font-weight: 600;">@b.Status</span>
                                        @if (!string.IsNullOrWhiteSpace(b.OrderId))
                                        {
                                            <span style="font-size: 0.75rem; padding: 0.15rem 0.5rem; border-radius: 4px; background: rgba(245, 158, 11, 0.1); color: #d97706; font-weight: 600;">Quote Ref: @b.OrderId</span>
                                        }
                                    </div>
                                    <div style="color: var(--ss-ink-muted); font-size: 0.9rem; margin-top: 0.25rem;">
                                        <a href="mailto:@b.ClientEmail" style="color: #3b82f6">@b.ClientEmail</a>
                                        @if (!string.IsNullOrWhiteSpace(b.ClientPhone)) { <span>&bull; @b.ClientPhone</span> }
                                        &bull; <strong>Scheduled: @b.PreferredDateTime.ToString("d MMM yyyy, HH:mm") UTC</strong>
                                        &bull; Created: @b.CreatedAt.ToString("d MMM yyyy")
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div style="padding: 1rem; border: 1px solid var(--ss-border); border-radius: var(--ss-radius-sm); font-size: 0.95rem;">
                            <strong>Purpose:</strong> @b.Purpose
                        </div>
                    </div>
                }
            </div>
        </div>

@* The catalogue, attributes, journal and gallery are all CatalogueManage. *@
@if (Model.ShowMasterSections) {
        <!-- 4. Manage Catalogue Tab -->
        <div id="tab-products" class="admin-tab-content" style="display: none;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
                <h3 style="margin: 0;">Manage Catalogue</h3>
                <button class="btn btn-primary" style="display: flex; align-items: center; gap: 0.5rem;" data-toggle-form="product">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Add New Product
                </button>
            </div>

            <!-- Add New Product Form -->
            <div id="form-add-product" class="card" style="padding: 3rem; margin-bottom: 2rem; border-top: 4px solid var(--ss-brand); display: none;">
                <h3 style="margin-bottom: 2rem;">Add New Product</h3>
                <form data-admin-save method="post" action="/Admin/Products/Create" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 2rem;">
                    @Html.AntiForgeryToken()
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
                        <div>
                            <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Product Name</label>
                            <input type="text" name="name" minlength="2" maxlength="160" class="input-field" placeholder="e.g. Signature Cast Iron Skillet" required />
                            <input type="hidden" name="sku" />
                            <input type="hidden" name="stockQuantity" value="10" />
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Product Images</label>
                            <input type="file" name="imageFiles" class="input-field" accept="image/*" multiple />
                            <small style="color: var(--ss-ink-muted); display: block; margin-top: 0.5rem;">Select one or more image files (each under 10MB). Uploads are added to the gallery.</small>
                            @* Filled in by admin-dashboard.js when an existing product is opened. *@
                            <div id="product-image-gallery" data-product-id="" style="display: none; gap: 0.75rem; flex-wrap: wrap; margin-top: 1rem;"></div>
                        </div>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1.5rem;">
                        <div>
                            <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Price (R)</label>
                            <input type="number" min="0.01" max="1000000" step="0.01" name="price" class="input-field" placeholder="1299.00" required />
                        </div>
                        <div>
                            <label for="type-list" style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Product Type</label>
                            @* Selects, not free text: a typo here creates a whole new facet that
                               splits the catalogue filters. New values are added deliberately in
                               the Attributes section, and the ids are the ones that section appends to. *@
                            <select id="type-list" name="cookwareType" class="input-field" required>
                                <option value="">Select a type&hellip;</option>
                                @foreach (var t in Model.Facets.CookwareTypes) { <option value="@t">@t</option> }
                            </select>
                        </div>
                        <div>
                            <label for="mat-list" style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Material</label>
                            <select id="mat-list" name="material" class="input-field">
                                <option value="">Not specified</option>
                                @foreach (var m in Model.Facets.Materials) { <option value="@m">@m</option> }
                            </select>
                        </div>
                        <div>
                            <label for="brand-list" style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Brand</label>
                            <select id="brand-list" name="brand" class="input-field" required>
                                <option value="">Select a brand&hellip;</option>
                                @foreach (var b in Model.Facets.Brands) { <option value="@b">@b</option> }
                            </select>
                        </div>
                        <div>
                            <label for="cat-list" style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Range</label>
                            <select id="cat-list" name="category" class="input-field" required>
                                <option value="">Select a range&hellip;</option>
                                @foreach (var c in Model.Facets.Categories) { <option value="@c">@c</option> }
                            </select>
                        </div>
                        <div>
                            <label for="size-list" style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Size</label>
                            <select id="size-list" name="sizeLabel" class="input-field">
                                <option value="">Not specified</option>
                                @foreach (var s in Model.Facets.SizeLabels) { <option value="@s">@s</option> }
                            </select>
                        </div>
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Description</label>
                        <textarea name="description" minlength="10" maxlength="4000" class="input-field" rows="4" placeholder="Detailed product description..." required></textarea>
                    </div>
                    <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 1rem;">
                        <button type="button" class="btn btn-outline" data-toggle-form="product">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Product</button>
                    </div>
                </form>
            </div>

            <!-- Product Grid & Filter -->
            <div id="products-grid">
                <div class="card" style="margin-bottom: 2rem; padding: 2rem; border-top: 4px solid var(--ss-brand);">
                    <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--ss-brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                        <h3 style="margin: 0; font-size: 1.5rem;">Filter Products</h3>
                    </div>

                    <form id="product-filter-form" method="get" action="/Admin#products">
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem;">
                            <div>
                                <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--ss-ink); font-size: 0.9rem;">Search keyword</label>
                                <div style="display: flex; align-items: center; background: var(--ss-surface-solid); padding: 0.5rem 1rem; border-radius: var(--ss-radius-sm);">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--ss-ink-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.5rem;"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                                    <input id="product-search" name="searchTerm" type="text" placeholder="Search..." value="@Model.ProductFilter.SearchTerm" style="flex: 1; border: none; background: transparent; outline: none; color: var(--ss-ink); font-size: 1rem;" />
                                </div>
                            </div>
                            <div>
                                <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--ss-ink); font-size: 0.9rem;">Product Type</label>
                                <select id="filter-type" name="cookwareType" class="input-field" style="background: var(--ss-surface-solid);">
                                    <option value="">[All Types]</option>
                                    @foreach (var t in Model.Facets.CookwareTypes) { <option value="@t" selected="@(t == Model.ProductFilter.CookwareType)">@t</option> }
                                </select>
                            </div>
                            <div>
                                <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--ss-ink); font-size: 0.9rem;">Material</label>
                                <select id="filter-material" name="material" class="input-field" style="background: var(--ss-surface-solid);">
                                    <option value="">[All Materials]</option>
                                    @foreach (var m in Model.Facets.Materials) { <option value="@m" selected="@(m == Model.ProductFilter.Material)">@m</option> }
                                </select>
                            </div>
                            <div>
                                <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--ss-ink); font-size: 0.9rem;">Brand</label>
                                <select id="filter-brand" name="brand" class="input-field" style="background: var(--ss-surface-solid);">
                                    <option value="">[All Brands]</option>
                                    @foreach (var b in Model.Facets.Brands) { <option value="@b" selected="@(b == Model.ProductFilter.Brand)">@b</option> }
                                </select>
                            </div>
                            <div>
                                <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--ss-ink); font-size: 0.9rem;">Range</label>
                                <select id="filter-range" name="category" class="input-field" style="background: var(--ss-surface-solid);">
                                    <option value="">[Product Range]</option>
                                    @foreach (var c in Model.Facets.Categories) { <option value="@c" selected="@(c == Model.ProductFilter.Category)">@c</option> }
                                </select>
                            </div>
                            <div>
                                <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--ss-ink); font-size: 0.9rem;">Size</label>
                                <select id="filter-size" name="sizeLabel" class="input-field" style="background: var(--ss-surface-solid);">
                                    <option value="">[Size]</option>
                                    @foreach (var s in Model.Facets.SizeLabels) { <option value="@s" selected="@(s == Model.ProductFilter.SizeLabel)">@s</option> }
                                </select>
                            </div>
                        </div>

                        <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 2rem;">
                            <a href="/Admin#products" class="btn btn-outline" style="padding: 0.5rem 1.5rem; text-decoration: none;">Clear Filters</a>
                            <button type="submit" class="btn btn-primary" style="padding: 0.5rem 1.5rem;">Filter</button>
                        </div>
                    </form>
                </div>

                <div id="product-cards-container" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
                    @if (Model.Products.Count == 0)
                    {
                        <div class="card" style="padding: 2.5rem; grid-column: 1 / -1; text-align: center; color: var(--ss-ink-muted);">
                            No products found in the catalogue.
                        </div>
                    }
                    @foreach (var p in Model.Products)
                    {
                        <div class="card product-admin-item"
                             data-name="@p.Name.ToLowerInvariant()"
                             data-type="@p.CookwareType.ToLowerInvariant()"
                             data-material="@(p.Material?.ToLowerInvariant() ?? "")"
                             data-brand="@p.Brand.ToLowerInvariant()"
                             data-range="@p.Category.ToLowerInvariant()"
                             data-size="@(p.SizeLabel?.ToLowerInvariant() ?? "")"
                             style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                <div style="width: 80px; height: 80px; background: #e5e9f0; display: flex; align-items: center; justify-content: center; border-radius: var(--ss-radius-sm); border: 2px dashed #c2c9d6; color: #4c566a; font-size: 0.7rem; overflow: hidden;">
                                    @if (p.PrimaryImage is not null)
                                    {
                                        <img src="@p.PrimaryImage.ThumbnailUrl" alt="@p.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <span>[Img]</span>
                                    }
                                </div>
                                <div style="display: flex; gap: 0.5rem;">
                                    <a href="#products" data-edit-product="@p.Id" style="color: #3b82f6; background: none; border: none; cursor: pointer; padding: 0.5rem; display: flex; align-items: center;" title="Edit Product"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg></a>
                                    <form method="post" action="/Admin/Products/@p.Id/delete" data-confirm="Are you sure you want to delete this product?" style="margin: 0;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" style="color: #ef4444; background: none; border: none; cursor: pointer; padding: 0.5rem; display: flex; align-items: center;" title="Delete Product"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg></button>
                                    </form>
                                </div>
                            </div>
                            <div>
                                <div style="font-size: 0.75rem; color: var(--ss-ink-muted); text-transform: uppercase;">@p.Brand • @(p.Material ?? "Premium")</div>
                                <h4 style="margin: 0.25rem 0; font-size: 1.1rem;">@p.Name</h4>
                                <div style="font-weight: bold; color: var(--ss-brand);">@p.Currency @p.Price.ToString("N2")</div>
                                <div style="font-size: 0.85rem; color: var(--ss-ink-muted); margin-top: 0.5rem;">Type: @p.CookwareType | Range: @p.Category | Size: @(p.SizeLabel ?? "Standard")</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- 5. Manage Attributes Tab -->
        <div id="tab-attributes" class="admin-tab-content" style="display: none;">
            <h3 style="margin-bottom: 2rem;">Manage Product Attributes</h3>

            <div class="card" style="padding: 2rem; margin-bottom: 2rem; max-width: 600px;">
                <label style="display: block; margin-bottom: 0.5rem; font-weight: 500; font-size: 0.9rem;">Attribute Type</label>
                <select id="select-attribute-filter" class="input-field" style="margin-bottom: 1.5rem;" data-attribute-filter>
                    <option value="all">All Attributes</option>
                    <option value="types">Product Types</option>
                    <option value="materials">Materials</option>
                    <option value="brands">Brands</option>
                    <option value="sizes">Sizes / Dimensions</option>
                    <option value="ranges">Ranges / Categories</option>
                </select>
                <div style="display: flex; justify-content: flex-end; gap: 1rem;">
                    <button class="btn" data-filter-attributes="all" style="background-color: #707b8e; color: white; border: none; padding: 0.5rem 1.5rem; border-radius: var(--ss-radius-sm); font-weight: 500; cursor: pointer;">Clear filters</button>
                    <button class="btn" data-filter-attributes="selected" style="background-color: #707b8e; color: white; border: none; padding: 0.5rem 1.5rem; border-radius: var(--ss-radius-sm); font-weight: 500; cursor: pointer;">Filter</button>
                </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                <!-- Product Types -->
                <div id="attr-sec-types" class="card" style="padding: 2rem;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start;">
                        <div>
                            <h4 style="margin: 0 0 1.5rem 0; font-size: 0.95rem; font-weight: 600;">Current Product Types</h4>
                            <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
                                @foreach (var t in Model.Facets.CookwareTypes)
                                {
                                    <div style="display: flex; align-items: center; gap: 0.5rem; background: #f1f5f9; padding: 0.4rem 0.8rem; border-radius: 50px; font-size: 0.85rem; color: #334155;">@t</div>
                                }
                            </div>
                        </div>
                        <div>
                            <h4 style="margin: 0 0 1.5rem 0; font-size: 0.95rem; font-weight: 500; color: #64748b;">New Value</h4>
                            <div style="display: flex; gap: 1rem;">
                                <input type="text" id="new-type-val" class="input-field" placeholder="e.g. Strainer" style="flex: 1;" />
                                <button type="button" class="btn btn-primary" data-add-attribute="cookwareType" data-input="new-type-val" style="padding: 0 2rem; border-radius: var(--ss-radius-sm);">Add</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Materials -->
                <div id="attr-sec-materials" class="card" style="padding: 2rem;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start;">
                        <div>
                            <h4 style="margin: 0 0 1.5rem 0; font-size: 0.95rem; font-weight: 600;">Current Materials</h4>
                            <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
                                @foreach (var m in Model.Facets.Materials)
                                {
                                    <div style="display: flex; align-items: center; gap: 0.5rem; background: #f1f5f9; padding: 0.4rem 0.8rem; border-radius: 50px; font-size: 0.85rem; color: #334155;">@m</div>
                                }
                            </div>
                        </div>
                        <div>
                            <h4 style="margin: 0 0 1.5rem 0; font-size: 0.95rem; font-weight: 500; color: #64748b;">New Value</h4>
                            <div style="display: flex; gap: 1rem;">
                                <input type="text" id="new-mat-val" class="input-field" placeholder="e.g. Ceramic" style="flex: 1;" />
                                <button type="button" class="btn btn-primary" data-add-attribute="material" data-input="new-mat-val" style="padding: 0 2rem; border-radius: var(--ss-radius-sm);">Add</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Brands -->
                <div id="attr-sec-brands" class="card" style="padding: 2rem;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start;">
                        <div>
                            <h4 style="margin: 0 0 1.5rem 0; font-size: 0.95rem; font-weight: 600;">Current brands</h4>
                            <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
                                @foreach (var b in Model.Facets.Brands)
                                {
                                    <div style="display: flex; align-items: center; gap: 0.5rem; background: #f1f5f9; padding: 0.4rem 0.8rem; border-radius: 50px; font-size: 0.85rem; color: #334155;">@b</div>
                                }
                            </div>
                        </div>
                        <div>
                            <h4 style="margin: 0 0 1.5rem 0; font-size: 0.95rem; font-weight: 500; color: #64748b;">New Value</h4>
                            <div style="display: flex; gap: 1rem;">
                                <input type="text" id="new-brand-val" class="input-field" placeholder="e.g. Le Creuset" style="flex: 1;" />
                                <button type="button" class="btn btn-primary" data-add-attribute="brand" data-input="new-brand-val" style="padding: 0 2rem; border-radius: var(--ss-radius-sm);">Add</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Sizes -->
                <div id="attr-sec-sizes" class="card" style="padding: 2rem;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start;">
                        <div>
                            <h4 style="margin: 0 0 1.5rem 0; font-size: 0.95rem; font-weight: 600;">Current Types</h4>
                            <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
                                @foreach (var s in Model.Facets.SizeLabels)
                                {
                                    <div style="display: flex; align-items: center; gap: 0.5rem; background: #f1f5f9; padding: 0.4rem 0.8rem; border-radius: 50px; font-size: 0.85rem; color: #334155;">@s</div>
                                }
                            </div>
                        </div>
                        <div>
                            <h4 style="margin: 0 0 1.5rem 0; font-size: 0.95rem; font-weight: 500; color: #64748b;">New Value</h4>
                            <div style="display: flex; gap: 1rem;">
                                <input type="text" id="new-size-val" class="input-field" placeholder="e.g. 36cm" style="flex: 1;" />
                                <button type="button" class="btn btn-primary" data-add-attribute="sizeLabel" data-input="new-size-val" style="padding: 0 2rem; border-radius: var(--ss-radius-sm);">Add</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Ranges -->
                <div id="attr-sec-ranges" class="card" style="padding: 2rem;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start;">
                        <div>
                            <h4 style="margin: 0 0 1.5rem 0; font-size: 0.95rem; font-weight: 600;">Current Ranges</h4>
                            <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
                                @foreach (var r in Model.Facets.Categories)
                                {
                                    <div style="display: flex; align-items: center; gap: 0.5rem; background: #f1f5f9; padding: 0.4rem 0.8rem; border-radius: 50px; font-size: 0.85rem; color: #334155;">@r</div>
                                }
                            </div>
                        </div>
                        <div>
                            <h4 style="margin: 0 0 1.5rem 0; font-size: 0.95rem; font-weight: 500; color: #64748b;">New Value</h4>
                            <div style="display: flex; gap: 1rem;">
                                <input type="text" id="new-range-val" class="input-field" placeholder="e.g. Signature" style="flex: 1;" />
                                <button type="button" class="btn btn-primary" data-add-attribute="category" data-input="new-range-val" style="padding: 0 2rem; border-radius: var(--ss-radius-sm);">Add</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 6. Manage Journal Tab -->
        <div id="tab-journal" class="admin-tab-content" style="display: none;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
                <h3 style="margin: 0;">Manage Journal</h3>
                <button class="btn btn-primary" style="display: flex; align-items: center; gap: 0.5rem;" data-toggle-form="journal">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Add New Entry
                </button>
            </div>

            <!-- Add New Journal Entry Form -->
            <div id="form-add-journal" class="card" style="padding: 3rem; margin-bottom: 2rem; border-top: 4px solid var(--ss-brand); display: none;">
                <h3 style="margin-bottom: 2rem;">Add New Entry</h3>
                <form data-admin-save method="post" action="/Admin/Journal/Create" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 2rem;">
                    @Html.AntiForgeryToken()
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
                        <div>
                            <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Title</label>
                            <input type="text" name="title" class="input-field" placeholder="Article Title" required />
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Article Images</label>
                            <input type="file" name="imageFile" class="input-field" accept="image/*" />
                            <small style="color: var(--ss-ink-muted); display: block; margin-top: 0.5rem;">Select image file (under 10MB)</small>
                        </div>
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Content</label>
                        <textarea name="content" class="input-field" rows="8" placeholder="Write your journal post content here..." required></textarea>
                    </div>
                    <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 1rem;">
                        <button type="button" class="btn btn-outline" data-toggle-form="journal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Entry</button>
                    </div>
                </form>
            </div>

            <div id="journal-grid" class="card" style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; min-width: 600px;">
                    <thead>
                        <tr style="background-color: rgba(0,0,0,0.02); border-bottom: 1px solid var(--ss-border); text-align: left;">
                            <th style="padding: 1.5rem; font-weight: 600;">Title</th>
                            <th style="padding: 1.5rem; font-weight: 600;">Date</th>
                            <th style="padding: 1.5rem; text-align: right; font-weight: 600;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.NewsPosts.Count == 0)
                        {
                            <tr>
                                <td colspan="3" style="padding: 2rem; text-align: center; color: var(--ss-ink-muted);">No journal entries found.</td>
                            </tr>
                        }
                        @foreach (var post in Model.NewsPosts)
                        {
                            <tr style="border-bottom: 1px solid var(--ss-border);">
                                <td style="padding: 1.5rem; font-weight: 500;">@post.Title</td>
                                <td style="padding: 1.5rem; color: var(--ss-ink-muted);">@post.CreatedAt.ToString("d MMM yyyy")</td>
                                <td style="padding: 1.5rem; text-align: right;">
                                    <div style="display: inline-flex; gap: 0.5rem; align-items: center;">
                                        <a href="#journal" data-edit-journal="@post.Id" style="padding: 0.5rem; color: #3b82f6; border: none; background: none; cursor: pointer; display: flex;" title="Edit Post"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg></a>
                                        <form method="post" action="/Admin/Journal/@post.Id/delete" data-confirm="Are you sure you want to delete this journal post?" style="margin: 0; display: inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" style="padding: 0.5rem; color: #ef4444; border: none; background: none; cursor: pointer; display: flex;" title="Delete Post"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 7. Manage Gallery Tab -->
        @* The home page mosaic has four fixed positions, so this manages those four
           rather than listing every file ever uploaded. *@
        <div id="tab-gallery" class="admin-tab-content" style="display: none;">
            <div id="gallery-container" class="card" style="padding: 2rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 2rem;">
                    <div>
                        <div style="font-weight: 600; font-size: 1.15rem; color: #1e293b;">Home page gallery</div>
                        <p style="margin: 0.35rem 0 0 0; color: var(--ss-ink-muted); font-size: 0.9rem;">
                            These four images fill the "In The Kitchen" band on the home page. The band is hidden while all four are empty.
                        </p>
                    </div>
                    <a href="/#gallery" target="_blank" style="color: var(--ss-brand); font-weight: 600; font-size: 0.9rem; text-decoration: none;">View on the home page &rarr;</a>
                </div>

                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem;">
                    @for (var slot = 1; slot <= SimmerAndSear.Domain.Entities.GalleryImage.SlotCount; slot++)
                    {
                        var image = Model.GalleryImages.FirstOrDefault(g => g.Slot == slot);
                        var shape = slot switch
                        {
                            1 => "Large tile, top left",
                            2 => "Small tile, top right",
                            3 => "Small tile, middle right",
                            _ => "Wide tile, bottom right"
                        };

                        <div style="border: 1px solid #e2e8f0; border-radius: var(--ss-radius-md); overflow: hidden; background: white;">
                            <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem; padding: 0.85rem 1.15rem; background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                                <span style="font-weight: 600; color: #1e293b;">Position @slot</span>
                                <span style="font-size: 0.8rem; color: var(--ss-ink-muted);">@shape</span>
                            </div>

                            <div style="aspect-ratio: 16/9; background: #e2e8f0; display: flex; align-items: center; justify-content: center; color: #64748b; font-size: 0.9rem;">
                                @if (image is not null)
                                {
                                    <img src="/api/media/@image.MediaAssetId/thumb" alt="@image.Caption" style="width: 100%; height: 100%; object-fit: cover;" />
                                }
                                else
                                {
                                    <span>Empty</span>
                                }
                            </div>

                            <form data-admin-save method="post" action="/Admin/Gallery/@slot" enctype="multipart/form-data" style="padding: 1.15rem;">
                                @Html.AntiForgeryToken()
                                <label for="gallery-caption-@slot" style="display: block; margin-bottom: 0.4rem; font-weight: 500; color: #475569; font-size: 0.9rem;">Caption</label>
                                <input id="gallery-caption-@slot" type="text" name="caption" class="input-field" value="@(image?.Caption)" maxlength="160" required
                                       placeholder="e.g. Searing steak in a cast-iron skillet" style="margin-bottom: 1rem;" />
                                <small style="color: #94a3b8; display: block; margin-top: -0.75rem; margin-bottom: 1rem; font-size: 0.78rem;">Read aloud to visitors using a screen reader.</small>

                                <label for="gallery-file-@slot" style="display: block; margin-bottom: 0.4rem; font-weight: 500; color: #475569; font-size: 0.9rem;">Image</label>
                                <input id="gallery-file-@slot" type="file" name="file" class="input-field" accept="image/*" required="@(image is null)" />
                                <small style="color: #94a3b8; display: block; margin-top: 0.4rem; font-size: 0.78rem;">
                                    @(image is null ? "Choose an image under 10 MB." : "Leave empty to keep the current image.")
                                </small>

                                <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.25rem;">
                                    <button type="submit" class="btn btn-primary" style="padding: 0.5rem 1.5rem; border: none; border-radius: var(--ss-radius-sm); font-weight: 500; cursor: pointer;">Save</button>
                                </div>
                            </form>

                            @if (image is not null)
                            {
                                <form method="post" action="/Admin/Gallery/@slot/clear" data-confirm="Remove the image in position @slot from the home page?" style="margin: 0; padding: 0 1.15rem 1.15rem;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" style="background: none; border: none; color: #ef4444; font-weight: 600; font-size: 0.85rem; cursor: pointer; padding: 0;">Clear this position</button>
                                </form>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
}

        <!-- 8. Manage Reviews Tab -->
        <div id="tab-reviews" class="admin-tab-content" style="display: none;">
            <div style="display: flex; justify-content: flex-end; align-items: center; margin-bottom: 2rem;">
                <select id="review-rating-filter" onchange="filterReviews(this.value)" style="padding: 0.6rem 1rem; border-radius: var(--ss-radius-sm); border: 1px solid #e2e8f0; width: 150px; background: white; font-size: 0.95rem; font-weight: 500; color: #1e293b; cursor: pointer;">
                    <option value="all">All Ratings</option>
                    <option value="5">5 Stars</option>
                    <option value="4">4 Stars</option>
                    <option value="3">3 Stars</option>
                    <option value="2">2 Stars</option>
                    <option value="1">1 Star</option>
                </select>
            </div>

            <div id="reviews-list-container" style="display: grid; grid-template-columns: 1fr; gap: 1.5rem;">
                @if (Model.Reviews.Count == 0)
                {
                    <div class="card" style="padding: 2.5rem; text-align: center; color: var(--ss-ink-muted);">
                        No reviews found.
                    </div>
                }
                @foreach (var rev in Model.Reviews)
                {
                    <div class="card review-card-item" data-rating="@rev.Rating" style="padding: 2rem; display: flex; flex-direction: column; gap: 1.5rem; border-left: 4px solid #8b5cf6;">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                            <div style="display: flex; gap: 1rem; align-items: center;">
                                <div style="padding: 0.75rem; background: #ede9fe; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2"><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg>
                                </div>
                                <div>
                                    <h4 style="margin: 0 0 0.25rem 0; font-size: 1.1rem; color: #1e293b; font-weight: 600;">@rev.ProductName</h4>
                                    <div style="color: #64748b; font-size: 0.85rem; font-weight: 500;">
                                        <strong>@rev.ClientName</strong> &bull; @rev.CreatedAt.ToString("d MMM yyyy") &bull; @rev.Rating Stars &bull; <span style="font-weight: 600; color: @(rev.Status == "Approved" ? "#10b981" : rev.Status == "Rejected" ? "#ef4444" : "#f59e0b")">@rev.Status</span>
                                    </div>
                                </div>
                            </div>
                            <form method="post" action="/Admin/Reviews/@rev.Id/delete" data-confirm="Are you sure you want to delete this review?" style="margin: 0;">
                                @Html.AntiForgeryToken()
                                <button type="submit" style="color: #ef4444; background: none; border: none; cursor: pointer; display: flex;" title="Delete Review"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg></button>
                            </form>
                        </div>

                        <div style="padding: 1.5rem; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: var(--ss-radius-sm); font-size: 0.95rem; color: #334155;">
                            <div style="font-weight: 600; margin-bottom: 0.25rem; color: #1e293b;">@rev.Title</div>
                            <div>@rev.Body</div>
                        </div>

                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <a href="mailto:?subject=Response to your review of @rev.ProductName" style="background: white; color: #1e293b; padding: 0.5rem 1rem; font-size: 0.9rem; border: 1px solid #cbd5e1; border-radius: var(--ss-radius-sm); font-weight: 500; text-decoration: none; cursor: pointer;">Reply to Customer</a>
                            <div style="display: flex; gap: 1rem;">
                                <form method="post" action="/Admin/Reviews/@rev.Id/reject" style="margin: 0;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" style="background: #e26a2c; color: white; border: none; padding: 0.6rem 1.5rem; border-radius: var(--ss-radius-sm); font-weight: 500; cursor: pointer;">Reject Review</button>
                                </form>
                                <form method="post" action="/Admin/Reviews/@rev.Id/approve" style="margin: 0;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" style="background: #76cfa6; color: white; border: none; padding: 0.6rem 1.5rem; border-radius: var(--ss-radius-sm); font-weight: 500; cursor: pointer;">Approve review</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- 9. Manage Partners Tab -->
        <div id="tab-partners" class="admin-tab-content" style="display: none;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
                <h3 style="margin: 0;">Manage Partners</h3>
                <button class="btn btn-primary" style="display: flex; align-items: center; gap: 0.5rem;" data-toggle-form="partner">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Add New Partner
                </button>
            </div>

            <!-- Add Partner Form -->
            <div id="form-add-partner" style="display: none; background: white; padding: 3rem; border-radius: var(--ss-radius-md); box-shadow: var(--ss-shadow-1); margin-bottom: 2rem;">
                <h3 style="margin: 0 0 2rem 0; font-size: 1.5rem;">Add Partner</h3>
                <form method="post" action="/Admin/Partners/Create">
                    @Html.AntiForgeryToken()
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2rem;">
                        <div>
                            <label style="display: block; margin-bottom: 0.5rem; font-weight: 500; color: #475569; font-size: 0.95rem;">Partner Name</label>
                            <input type="text" name="name" required style="width: 100%; padding: 0.75rem; border: 1px solid #e2e8f0; border-radius: var(--ss-radius-sm); font-size: 1rem; color: #1e293b;" />
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 0.5rem; font-weight: 500; color: #475569; font-size: 0.95rem;">Location / Address</label>
                            <input type="text" name="location" required style="width: 100%; padding: 0.75rem; border: 1px solid #e2e8f0; border-radius: var(--ss-radius-sm); font-size: 1rem; color: #1e293b;" />
                        </div>
                    </div>
                    <div style="margin-bottom: 3rem;">
                        <label style="display: block; margin-bottom: 0.5rem; font-weight: 500; color: #475569; font-size: 0.95rem;">Description</label>
                        <textarea name="description" style="width: 100%; padding: 0.75rem; border: 1px solid #e2e8f0; border-radius: var(--ss-radius-sm); font-size: 1rem; color: #1e293b; min-height: 120px;"></textarea>
                    </div>
                    <div style="display: flex; justify-content: flex-end; gap: 1rem;">
                        <button type="button" style="background: black; color: white; border: none; padding: 0.6rem 2rem; border-radius: var(--ss-radius-sm); font-weight: 500; cursor: pointer;" data-toggle-form="partner">Cancel</button>
                        <button type="submit" style="background: #e26a2c; color: white; border: none; padding: 0.6rem 2rem; border-radius: var(--ss-radius-sm); font-weight: 500; cursor: pointer;">Save Changes</button>
                    </div>
                </form>
            </div>

            <div id="partners-grid" class="card" style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; min-width: 600px;">
                    <thead>
                        <tr style="background-color: rgba(0,0,0,0.02); border-bottom: 1px solid var(--ss-border); text-align: left;">
                            <th style="padding: 1.5rem; color: #e26a2c; font-weight: 600;">Partner Name</th>
                            <th style="padding: 1.5rem; color: #e26a2c; font-weight: 600;">Location</th>
                            <th style="padding: 1.5rem; color: #e26a2c; text-align: right; font-weight: 600;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Partners.Count == 0)
                        {
                            <tr>
                                <td colspan="3" style="padding: 2rem; text-align: center; color: var(--ss-ink-muted);">No retail partners found.</td>
                            </tr>
                        }
                        @foreach (var partner in Model.Partners)
                        {
                            <tr style="border-bottom: 1px solid var(--ss-border);">
                                <td style="padding: 1.5rem; font-weight: 500;">
                                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M12 6h.01"/><path d="M12 10h.01"/><path d="M12 14h.01"/><path d="M16 10h.01"/><path d="M16 14h.01"/><path d="M8 10h.01"/><path d="M8 14h.01"/></svg> @partner.Name
                                    </div>
                                </td>
                                <td style="padding: 1.5rem; color: var(--ss-ink-muted);">@partner.Location</td>
                                <td style="padding: 1.5rem; text-align: right;">
                                    <form method="post" action="/Admin/Partners/@partner.Id/delete" data-confirm="Are you sure you want to delete this retail partner?" style="margin: 0; display: inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" style="padding: 0.5rem; color: #ef4444; border: none; background: none; cursor: pointer;" title="Delete Partner"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

@if (Model.ShowMasterSections) {
        <!-- 10. Settings Tab -->
        <div id="tab-settings" class="admin-tab-content" style="display: none;">
            <div class="card" style="padding: 3rem; max-width: 600px; margin: 0 auto;">
                <h3 style="margin-bottom: 2rem;">System Settings</h3>
                <form method="post" action="/Admin/Settings" style="display: flex; flex-direction: column; gap: 1.5rem;">
                    @Html.AntiForgeryToken()
                    <div>
                        <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Sales / Contact System Email</label>
                        <input type="email" name="salesNotificationEmail" class="input-field" value="@Model.Settings.SalesNotificationEmail" required />
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Bulk Order Threshold (R)</label>
                        <input type="number" step="0.01" name="bulkOrderThreshold" class="input-field" value="@Model.Settings.BulkOrderThreshold" required />
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Flat Shipping Rate (R)</label>
                        <input type="number" step="0.01" name="shippingFlatRate" class="input-field" value="@Model.Settings.ShippingFlatRate" required />
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 0.5rem; font-weight: 500;">Currency</label>
                        <input type="text" name="displayCurrency" class="input-field" value="@Model.Settings.DisplayCurrency" required />
                    </div>
                    <button type="submit" class="btn btn-primary" style="width: fit-content;">Save Settings</button>
                </form>
            </div>
        </div>
}

        <!-- 11. Manage Admins Tab (MasterAdmin only) -->
        @if (User.IsInRole("MasterAdmin")) {
        <div id="tab-admins" class="admin-tab-content" style="display: none;">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
                <!-- Admin Roles Reference -->
                <div class="card" style="padding: 2.5rem; background: white; border-radius: var(--ss-radius-md); box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">
                    <h3 style="margin: 0 0 1.5rem 0; font-size: 1.5rem;">Configured System Roles</h3>
                    <div style="display: flex; flex-direction: column; gap: 1rem;">
                        <div style="padding: 1.25rem; border: 1px solid #e2e8f0; border-radius: var(--ss-radius-sm);">
                            <h4 style="margin: 0 0 0.25rem 0; font-size: 1.1rem; color: #1e293b;">Master Admin</h4>
                            <div style="font-size: 0.85rem; color: #64748b;">Access: Full system control (Catalogue, Accounts, Audit Log, Settings, Orders, Reviews, News)</div>
                        </div>
                        <div style="padding: 1.25rem; border: 1px solid #e2e8f0; border-radius: var(--ss-radius-sm);">
                            <h4 style="margin: 0 0 0.25rem 0; font-size: 1.1rem; color: #1e293b;">Sales Admin</h4>
                            <div style="font-size: 0.85rem; color: #64748b;">Access: Operational control (Orders, Inquiries, Bulk Requests, Reviews, Partners, Journal)</div>
                        </div>
                    </div>
                </div>

                <!-- Admin Users -->
                <div class="card" style="padding: 2.5rem; background: white; border-radius: var(--ss-radius-md); box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">
                    <h3 style="margin: 0 0 1.5rem 0; font-size: 1.5rem;">Admin Users</h3>
                    <form method="post" action="/Admin/Users/Create" style="margin-bottom: 2rem;">
                        @Html.AntiForgeryToken()
                        <input type="email" name="email" placeholder="Email / Username" required style="width: 100%; padding: 0.75rem; border: 1px solid #e2e8f0; border-radius: var(--ss-radius-sm); margin-bottom: 1rem; font-size: 0.95rem; color: #475569;" />
                        <input type="password" name="password" placeholder="Password (min 8 chars)" required minlength="8" style="width: 100%; padding: 0.75rem; border: 1px solid #e2e8f0; border-radius: var(--ss-radius-sm); margin-bottom: 1rem; font-size: 0.95rem; color: #475569;" />
                        <select name="role" required style="width: 100%; padding: 0.75rem; border: 1px solid #e2e8f0; border-radius: var(--ss-radius-sm); margin-bottom: 1.5rem; font-size: 0.95rem; color: #475569; background: white;">
                            <option value="SalesAdmin">SalesAdmin</option>
                            <option value="MasterAdmin">MasterAdmin</option>
                        </select>
                        <button type="submit" style="width: 100%; padding: 0.75rem; background: #e26a2c; color: white; border: none; border-radius: var(--ss-radius-sm); font-weight: 600; cursor: pointer;">Create User</button>
                    </form>

                    <div style="display: flex; flex-direction: column; gap: 1rem;">
                        @foreach (var admin in Model.AdminUsers)
                        {
                            <div style="display: flex; justify-content: space-between; align-items: center; padding: 1.25rem; border: 1px solid #e2e8f0; border-radius: var(--ss-radius-sm);">
                                <div>
                                    <h4 style="margin: 0 0 0.25rem 0; font-size: 1.1rem; color: #1e293b;">@admin.Email</h4>
                                    <div style="font-size: 0.85rem; color: #94a3b8;">Role: @admin.Role | Active: @admin.IsActive</div>
                                </div>
                                <div style="display: flex; gap: 0.75rem;">
                                    <form method="post" action="/Admin/Users/@admin.Id/delete" data-confirm="Are you sure you want to delete this administrator?" style="margin: 0;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" style="color: #ef4444; background: none; border: none; cursor: pointer;" title="Delete User"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg></button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        }

    </div>
</div>

@section Scripts {
    <script src="~/js/admin-dashboard.js" asp-append-version="true"></script>
}
