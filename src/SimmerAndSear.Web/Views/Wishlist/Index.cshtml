@using SimmerAndSear.Web.ViewModels
@using SimmerAndSear.Contracts.Wishlist
@model WishlistPageVm

<div class="animate-fade-in">
  <div class="page-header">
    <div class="container">
      <h1>Your Wishlist</h1>
      <p>Review your selected products and generate a custom PDF lookbook or request a quote.</p>
    </div>
  </div>

  <div class="container" style="margin-top: 2rem;">
    <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: 1rem 1.5rem; display: flex; align-items: center; gap: 1rem;">
      <div style="color: #3b82f6; font-size: 1.5rem;">ℹ️</div>
      <p style="margin: 0; color: #1e3a8a; font-size: 0.95rem;">
        <strong>Bulk Order Policy:</strong> If your order total reaches <strong>@Money.FormatWhole(Model.BulkOrderThreshold, Model.Currency)</strong>, it qualifies as a bulk order. An agent must be booked to finalize the order and discuss potential wholesale discounts.
      </p>
    </div>
  </div>

  <section class="section-light">
    <div class="container">
      <div style="display: grid; grid-template-columns: 1fr 400px; gap: 4rem;">
        
        <div>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
            <h3 style="font-size: 1.5rem; margin: 0;">Selected Products (@Model.Wishlist.Count)</h3>
            <div style="display: flex; gap: 1rem; align-items: center;">
              <span style="font-size: 1.2rem; font-weight: bold;">Total: @Money.Format(Model.Total, Model.Currency)</span>
              <button class="btn btn-outline" data-wishlist-clear style="padding: 0.5rem 1rem; font-size: 0.85rem; color: #ef4444; border-color: #ef4444;">Clear Wishlist</button>
            </div>
          </div>

          <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            @foreach (var item in Model.Wishlist.Items)
            {
            <div class="card" style="display: flex; padding: 1rem; gap: 1.5rem; align-items: center; flex-wrap: wrap;">
              @if (item.ImageId is { Length: > 0 })
              {
              <a href="/Catalogue/Detail/@item.ProductId" style="display: block; width: 100px; height: 100px; flex: 0 0 100px; border-radius: var(--ss-radius-sm); overflow: hidden; background: #e5e9f0;">
                <img src="/api/media/@item.ImageId/thumb" alt="@item.ImageAlt" loading="lazy" width="100" height="100" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
              </a>
              }
              else
              {
              <a href="/Catalogue/Detail/@item.ProductId" style="display: block; width: 100px; height: 100px; background: #e5e9f0; display: flex; align-items: center; justify-content: center; text-decoration: none; border-radius: var(--ss-radius-sm); border: 2px dashed #c2c9d6; color: #4c566a; font-size: 0.8rem; text-align: center;">
                [Img]
              </a>
              }
              <div style="flex: 1 1 200px;">
                <div style="font-size: 0.75rem; color: var(--ss-ink-muted); text-transform: uppercase; font-weight: 600;">@item.Brand@(string.IsNullOrWhiteSpace(item.Material) ? "" : " • " + item.Material)</div>
                <a href="/Catalogue/Detail/@item.ProductId" style="text-decoration: none; color: inherit;">
                  <h4 style="font-size: 1.15rem; margin: 0.25rem 0;">@item.ProductName</h4>
                </a>
                <div style="font-weight: 600; color: var(--ss-brand); margin-top: 0.5rem;">@Money.Format(item.UnitPrice)</div>
              </div>

              <div style="display: flex; align-items: center; gap: 0.5rem; background: var(--ss-surface-alt); padding: 0.25rem; border-radius: 50px;">
                <button style="padding: 0.5rem; background: white; border-radius: 50%; box-shadow: var(--ss-shadow-1);">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" x2="19" y1="12" y2="12"/></svg>
                </button>
                <span style="font-weight: 600; width: 20px; text-align: center;">1</span>
                <button style="padding: 0.5rem; background: white; border-radius: 50%; box-shadow: var(--ss-shadow-1);">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="5" y2="19"/><line x1="5" x2="19" y1="12" y2="12"/></svg>
                </button>
              </div>

              <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                <button data-wishlist-move="@item.ProductId" style="color: var(--ss-brand); background: none; border: none; padding: 0.5rem; cursor: pointer; display: flex; align-items: center; gap: 0.25rem; font-size: 0.8rem;" title="Move to Cart">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
                </button>
                <button data-wishlist-remove="@item.ProductId" style="color: #ef4444; background: none; border: none; padding: 0.5rem; cursor: pointer; display: flex; align-items: center; gap: 0.25rem; font-size: 0.8rem;" title="Remove from Wishlist">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
                </button>
              </div>
            </div>
            }
          </div>
        </div>

        <div>
          <div class="card" style="padding: 2.5rem; margin-bottom: 2rem; background: var(--ss-surface-solid);">
            <h3 style="margin-bottom: 1rem; font-size: 1.25rem; margin-top: 0;">Generate PDF Lookbook</h3>
            <p style="color: var(--ss-ink-muted); margin-bottom: 1.5rem; font-size: 0.95rem;">
              Download a beautifully formatted, branded PDF containing all the products in your wishlist. Perfect for sharing with your team.
            </p>
            @if (Model.Wishlist.Count == 0)
            {
              <button class="btn btn-secondary" style="width: 100%;" disabled title="Add a product to your wishlist first">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.5rem;"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><line x1="10" x2="8" y1="9" y2="9"/></svg> Download PDF Lookbook
              </button>
            }
            else
            {
              <a href="/api/wishlist/lookbook" target="_blank" rel="noopener" class="btn btn-secondary" style="width: 100%; display: inline-flex; align-items: center; justify-content: center; text-decoration: none;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.5rem;"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><line x1="10" x2="8" y1="9" y2="9"/></svg> Download PDF Lookbook
              </a>
            }
          </div>

          <div class="card" style="padding: 2.5rem; background: var(--ss-surface);">
            <h3 style="margin-bottom: 1.5rem; font-size: 1.25rem; margin-top: 0;">
              Request Formal Quote
            </h3>
            <form data-wishlist-quote style="display: flex; flex-direction: column; gap: 1.25rem;">
              <div>
                <label style="display: block; margin-bottom: 0.5rem; font-size: 0.9rem; font-weight: 500;">Full Name *</label>
                <input type="text" name="name" required class="input-field" />
              </div>
              <div>
                <label style="display: block; margin-bottom: 0.5rem; font-size: 0.9rem; font-weight: 500;">Email Address *</label>
                <input type="email" name="email" required class="input-field" />
              </div>
              <div>
                <label style="display: block; margin-bottom: 0.5rem; font-size: 0.9rem; font-weight: 500;">Company Name</label>
                <input type="text" name="company" class="input-field" />
              </div>
              <div>
                <label style="display: block; margin-bottom: 0.5rem; font-size: 0.9rem; font-weight: 500;">Additional Notes</label>
                <textarea rows="3" name="notes" class="input-field"></textarea>
              </div>
              <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.5rem;"><line x1="22" x2="11" y1="2" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg> Submit Quote Request
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

@section Scripts {
    <script src="~/js/wishlist.js" asp-append-version="true"></script>
}
