@using SimmerAndSear.Web.ViewModels.Components
@model LoadingVm

<div role="status" aria-live="polite" style="display: flex; align-items: center; justify-content: center; padding: var(--ss-space-8); gap: var(--ss-space-4);">
    <div class="spinner" style="width: 24px; height: 24px; border: 3px solid var(--ss-border); border-top-color: var(--ss-brand); border-radius: 50%; animation: spin 1s linear infinite;"></div>
    <span class="visually-hidden" style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;">@Model.Label</span>
</div>

<style>
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
    @@media (prefers-reduced-motion: reduce) {
        .spinner { animation: none !important; }
    }
</style>
