@using SimmerAndSear.Web.ViewModels.Components
@model BreadcrumbVm

@if (Model.Items != null && Model.Items.Any())
{
    <nav aria-label="Breadcrumb" style="margin-bottom: var(--ss-space-6);">
        <ol style="list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--ss-space-2); align-items: center; font-size: var(--ss-text-sm);">
            @for (int i = 0; i < Model.Items.Count; i++)
            {
                var item = Model.Items[i];
                var isLast = i == Model.Items.Count - 1;
                
                <li style="display: flex; align-items: center; gap: var(--ss-space-2);">
                    @if (isLast)
                    {
                        <span aria-current="page" style="color: var(--ss-ink); font-weight: 500;">@item.Label</span>
                    }
                    else
                    {
                        <a href="@item.Href" style="color: var(--ss-ink-muted); text-decoration: underline;">@item.Label</a>
                        <span style="color: var(--ss-border);" aria-hidden="true">/</span>
                    }
                </li>
            }
        </ol>
    </nav>
}
