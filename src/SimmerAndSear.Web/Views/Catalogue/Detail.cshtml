@using SimmerAndSear.Web.ViewModels
@using SimmerAndSear.Web.ViewModels.Components
@using SimmerAndSear.Contracts.Catalogue
@model ProductDetailResponse

<div class="animate-fade-in">
    <div class="section-light" style="min-height: 80vh; padding-top: 2rem;">
        <div class="container">
            <a href="/Catalogue" style="display: inline-flex; align-items: center; gap: 0.5rem; color: var(--ss-ink-muted); margin-bottom: 2rem; font-size: 0.9rem; font-weight: 500; text-decoration: none;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg> Back
            </a>

            <div style="display: flex; flex-wrap: wrap; gap: 4rem;">
                <!-- Image Gallery -->
                <div style="flex: 1 1 400px;">
                    <div style="position: relative; border-radius: var(--ss-radius); overflow: hidden; background: #e5e9f0; @(Model.PrimaryImage is null ? "border: 2px dashed #c2c9d6;" : "") aspect-ratio: 1/1; display: flex; align-items: center; justify-content: center; color: #4c566a; font-weight: 500;">
                        @if (Model.PrimaryImage is { } main)
                        {
                            <img id="gallery-main" src="@main.Url" alt="@main.AltText" style="width: 100%; height: 100%; object-fit: cover;" />
                        }
                        else
                        {
                            <text>[Main Product Image]</text>
                        }

                        @if (Model.Images.Count > 1)
                        {
                            <button type="button" data-gallery-step="-1" aria-label="Previous image" style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); background: rgba(255,255,255,0.9); border: none; border-radius: 50%; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; box-shadow: var(--ss-shadow-2); z-index: 2;">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                            </button>
                            <button type="button" data-gallery-step="1" aria-label="Next image" style="position: absolute; right: 1rem; top: 50%; transform: translateY(-50%); background: rgba(255,255,255,0.9); border: none; border-radius: 50%; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; box-shadow: var(--ss-shadow-2); z-index: 2;">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                            </button>
                        }
                    </div>
                    
                    <!-- Thumbnails -->
                    <div style="display: flex; gap: 1rem; margin-top: 1rem; overflow-x: auto; padding-bottom: 0.5rem;">
                        @for (var i = 0; i < Model.Images.Count; i++)
                        {
                            var image = Model.Images[i];
                            <button type="button" data-gallery-pick="@i" data-full="@image.Url" data-alt="@image.AltText" aria-label="Show image @(i + 1)" style="width: 80px; height: 80px; flex-shrink: 0; border-radius: var(--ss-radius-sm); overflow: hidden; border: 2px @(i == 0 ? "solid var(--ss-brand)" : "dashed #c2c9d6"); padding: 0; background: #e5e9f0; color: #4c566a; font-size: 0.8rem; display: flex; align-items: center; justify-content: center;">
                                <img src="@image.ThumbnailUrl" alt="@image.AltText" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;" />
                            </button>
                        }
                    </div>
                </div>

                <!-- Product Details -->
                <div style="flex: 1 1 400px; display: flex; flex-direction: column;">
                    <div style="font-size: 0.85rem; color: var(--ss-ink-muted); text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em; margin-bottom: 0.5rem;">
                        @Model.Brand@(string.IsNullOrWhiteSpace(Model.Material) ? "" : " • " + Model.Material)
                    </div>
                    <h1 style="font-size: 2.5rem; margin: 0 0 1rem 0;">@Model.Name</h1>

                    <div style="font-size: 2rem; font-weight: 700; color: var(--ss-brand); margin-bottom: 1.5rem;">
                        @Money.Format(Model.Price, Model.Currency)
                    </div>

                    <div style="display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;">
                        @if (!string.IsNullOrWhiteSpace(Model.SizeLabel))
                        {
                            <div style="background: var(--ss-surface-solid); padding: 0.5rem 1rem; border-radius: var(--ss-radius-sm); font-size: 0.9rem; font-weight: 500;">
                                <span style="color: var(--ss-ink-muted);">Size:</span> @Model.SizeLabel
                            </div>
                        }
                        <div style="background: var(--ss-surface-solid); padding: 0.5rem 1rem; border-radius: var(--ss-radius-sm); font-size: 0.9rem; font-weight: 500;">
                            <span style="color: var(--ss-ink-muted);">Range:</span> @Model.Category
                        </div>
                        <div style="background: var(--ss-surface-solid); padding: 0.5rem 1rem; border-radius: var(--ss-radius-sm); font-size: 0.9rem; font-weight: 500;">
                            <span style="color: var(--ss-ink-muted);">Availability:</span> @(Model.InStock ? $"{Model.StockQuantity} in stock" : "Out of stock")
                        </div>
                    </div>

                    <p style="font-size: 1.1rem; color: var(--ss-ink-muted); line-height: 1.6; margin-bottom: 3rem;">
                        @Model.Description
                    </p>

                    <form style="display: flex; gap: 1rem; margin-bottom: 3rem; flex-wrap: wrap;">
                        <div style="display: flex; align-items: center; border: 1px solid var(--ss-border); border-radius: var(--ss-radius-sm); overflow: hidden;">
                            <button type="button" data-qty-step="-1" data-qty-target="qty-value" aria-label="Decrease quantity" style="padding: 1rem; background: var(--ss-surface-solid); border: none; cursor: pointer;">-</button>
                            <span id="qty-value" data-max="@Model.StockQuantity" aria-live="polite" style="padding: 0 1rem; font-weight: 600; min-width: 40px; text-align: center;">1</span>
                            <button type="button" data-qty-step="1" data-qty-target="qty-value" aria-label="Increase quantity" style="padding: 1rem; background: var(--ss-surface-solid); border: none; cursor: pointer;">+</button>
                        </div>

                        <button type="button" class="btn btn-primary" data-add-to-cart="@Model.Id" data-quantity-from="qty-value" disabled="@(!Model.InStock)" style="flex: 1 1 200px; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg> @(Model.InStock ? "Add to Cart" : "Out of Stock")
                        </button>
                        
                        <button type="button" class="btn btn-outline" style="width: 60px; padding: 0; display: flex; align-items: center; justify-content: center;" data-add-to-wishlist="@Model.Id" title="Add to Wishlist">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                        </button>
                    </form>

                    <!-- Reviews Section -->
                    <div style="border-top: 1px solid var(--ss-border); padding-top: 2rem;">
                        <h3 style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.5rem;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg> Customer Reviews (<span id="reviews-count">0</span>)
                        </h3>
                        
                        <div id="product-reviews-container" data-product-id="@Model.Id" style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem; max-height: 350px; overflow-y: auto;">
                            <div id="reviews-loading" style="color: var(--ss-ink-muted); font-size: 0.95rem;">Loading reviews...</div>
                        </div>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="card" style="padding: 1.5rem; background: var(--ss-surface-solid);">
                                <h4 style="margin-bottom: 1rem; margin-top: 0;">Write a Review</h4>
                                <div id="review-feedback" style="display: none; padding: 0.75rem 1rem; border-radius: 6px; margin-bottom: 1rem; font-size: 0.95rem;"></div>
                                <form id="product-review-form" data-product-id="@Model.Id" style="display: flex; flex-direction: column; gap: 1rem;">
                                    @Html.AntiForgeryToken()
                                    <div style="display: flex; justify-content: space-between; align-items: center;">
                                        <label for="review-rating" style="font-weight: 500;">Rating:</label>
                                        <select id="review-rating" name="rating" class="input-field" style="width: auto; padding: 0.5rem 2rem 0.5rem 1rem;">
                                            <option value="5">★★★★★ (5 Stars)</option>
                                            <option value="4">★★★★☆ (4 Stars)</option>
                                            <option value="3">★★★☆☆ (3 Stars)</option>
                                            <option value="2">★★☆☆☆ (2 Stars)</option>
                                            <option value="1">★☆☆☆☆ (1 Star)</option>
                                        </select>
                                    </div>
                                    <div>
                                        <input type="text" id="review-title" name="title" class="input-field" placeholder="Review headline or summary" required maxlength="160" minlength="2" />
                                    </div>
                                    <textarea id="review-body" name="body" class="input-field" rows="3" placeholder="Share your experience with this cookware..." required maxlength="4000" minlength="10"></textarea>
                                    <button id="review-submit-btn" type="submit" class="btn btn-secondary" style="align-self: flex-start;">
                                        <span>Submit Review</span>
                                    </button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <div class="card" style="padding: 1.5rem; background: var(--ss-surface-solid); text-align: center;">
                                <p style="margin: 0; color: var(--ss-ink-muted); font-size: 0.95rem;">
                                    Purchased this product? <a href="/Auth/Login?returnUrl=@Context.Request.Path" style="color: var(--ss-brand); font-weight: 600;">Sign in</a> to share your review.
                                </p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/catalogue.js" asp-append-version="true"></script>
    <script src="~/js/wishlist.js" asp-append-version="true"></script>
    <script src="~/js/engagement.js" asp-append-version="true"></script>
}
